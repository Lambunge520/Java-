def current_archive_suffix(url):
    lower = normalize_text(url).lower()
    if lower.endswith(".tar.gz"):
        return ".tar.gz"
    parsed = urlparse(lower)
    if parsed.path.endswith(".tar.gz"):
        return ".tar.gz"
    return ".zip"


