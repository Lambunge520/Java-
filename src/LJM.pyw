    def set_env_var(self):
        selected = self.tree_fix.selection()
        if not selected:
            return
        path = self.tree_fix.item(selected[0])["values"][2]
        if not IS_WIN:
            try:
                written = write_unix_java_environment(path)
                messagebox.showinfo(
                    "注入成功",
                    "已写入当前用户 Java 环境配置:\n"
                    f"JAVA_HOME={path}\n\n"
                    "生效文件:\n"
                    + "\n".join(written)
                    + "\n\n新开的终端会自动生效；当前已运行的终端需要重新打开。",
                )
            except Exception as exc:
                messagebox.showerror("写入失败", str(exc))
            return
        try:
            key = winreg.OpenKey(
                winreg.HKEY_LOCAL_MACHINE,
                r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment",
                0,
                winreg.KEY_WRITE,
            )
            winreg.SetValueEx(key, "JAVA_HOME", 0, winreg.REG_SZ, path)
            winreg.CloseKey(key)
            ctypes.windll.user32.SendMessageTimeoutW(0xFFFF, 0x001A, 0, "Environment", 0, 1000, None)
            messagebox.showinfo("注入成功", f"当前全局系统变量 JAVA_HOME 已设为:\n{path}")
        except Exception as exc:
            messagebox.showerror("提权拦截", str(exc))

    def fix_registry_structure(self):
        selected = self.tree_fix.selection()
        if not selected:
            return
        meta = self.fix_items.get(selected[0], {})
        java_home = meta.get("java_home") or self.tree_fix.item(selected[0])["values"][2]
        preferred_name = meta.get("registry_name") or build_registry_name(read_java_runtime_info(java_home))
        synced = JavaRegistryAdapter.sync_runtime_registration(java_home, preferred_name=preferred_name)
        if not synced:
            return messagebox.showerror("注册失败", "未能写回 Java 注册信息。")
        title = "注册表急救" if IS_WIN else "本机索引修复"
        message = "底层关联路径已经重写完成。" if IS_WIN else "用户级 Java 索引已经重写完成。"
        messagebox.showinfo(title, message)
        self.refresh_all_data()

    def rollback_latest_backup(self):
        target_path = ""
        selected = self.tree_fix.selection()
        if selected:
            meta = self.fix_items.get(selected[0], {})
            target_path = meta.get("java_home") or self.tree_fix.item(selected[0])["values"][2]

        backups = list_java_backups(target_path) if target_path else []
        if not backups:
            backups = list_java_backups()
        if not backups:
            return messagebox.showinfo("没有可回滚备份", "当前还没有可用的 Java 修复/更新备份。")

        _created_at, backup_dir, manifest = backups[0]
        target_path = manifest.get("target_path", target_path)
        created_text = manifest.get("created_text", "未知时间")
        if not self._confirm_process_usage(target_path, "回滚"):
            return
        if not messagebox.askyesno(
            "确认回滚",
            f"即将把以下 Java 环境恢复到最近备份:\n{target_path}\n\n备份时间: {created_text}\n备份目录: {backup_dir}\n\n是否继续？",
        ):
            return

        top = tk.Toplevel(self.root)
        self._configure_popup(top, "正在回滚 Java 备份...", 480, 150, min_w=380, min_h=130, max_w_ratio=0.7, max_h_ratio=0.32, resizable=False)
        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, mode="indeterminate")
        progress.pack(fill=tk.X, padx=24, pady=(24, 12))
        progress.start()
        status_label = tk.Label(top, text="正在恢复备份，请稍候...", justify="center", wraplength=420)
        status_label.pack(fill=tk.X, padx=16)
        self._traverse_and_paint(top)

        def worker():
            try:
                restore_java_backup(backup_dir)
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showinfo("回滚完成", f"已恢复备份:\n{target_path}"))
                self.root.after(0, self.refresh_all_data)
            except Exception as exc:
                logging.error("回滚备份失败: %s\n%s", exc, traceback.format_exc())
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showerror("回滚失败", str(exc)))

        threading.Thread(target=worker, daemon=True).start()

    def download_and_extract(self, vendor, major_version, target_path, is_repair=False, preferred_registry_name=None):
        return self.download_and_extract_popup_v2(vendor, major_version, target_path, is_repair=is_repair, preferred_registry_name=preferred_registry_name)
        top = tk.Toplevel(self.root)
        top.title("正在进行底层通信...")
        top.geometry("480x160")
        top.grab_set()
        if self.icon_img:
            top.iconphoto(True, self.icon_img)
        top.configure(bg=self.current_bg)

        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, length=420, mode="determinate")
        progress.pack(pady=20)
        status_label = tk.Label(top, text="正在连接供应商更新源...")
        status_label.pack()
        self._traverse_and_paint(top)

        def update_progress(percent, downloaded, total):
            self.root.after(0, lambda: progress.config(value=percent))
            if total > 0:
                text = f"下载中: {downloaded / 1024 / 1024:.1f} MB / {total / 1024 / 1024:.1f} MB"
            else:
                text = f"下载中: {downloaded / 1024 / 1024:.1f} MB"
            self.root.after(0, lambda: status_label.config(text=text))

        def update_status(message):
            self.root.after(0, lambda: status_label.config(text=message))

        def task():
            info = None
            temp_archive = ""
            extract_dir = ""
            try:
                info = JavaDownloadEngine.get_latest_download_info(vendor, major_version)
                if not info:
                    raise Exception("未从更新源拿到有效构建包，请稍后重试。")

                suffix = download_info_archive_suffix(info)
                fd, temp_archive = tempfile.mkstemp(suffix=suffix)
                os.close(fd)

                update_status(f"已锁定更新源: {info.get('source', '未知源')}，准备下载...")
                download_urls = info.get("urls") or [info["url"]]
                NetworkEngine.download_from_candidates(download_urls, temp_archive, update_progress, update_status)

                self.root.after(0, lambda: progress.config(mode="indeterminate"))
                self.root.after(0, progress.start)
                update_status("下载完成，正在做安全校验并释放文件...")

                extract_dir = tempfile.mkdtemp()
                if suffix == ".tar.gz":
                    with tarfile.open(temp_archive, "r:gz") as tar_ref:
                        safe_extract_tar(tar_ref, extract_dir)
                else:
                    with zipfile.ZipFile(temp_archive, "r") as zip_ref:
                        safe_extract_zip(zip_ref, extract_dir)

                source_jdk_dir = None
                exe = "java.exe" if IS_WIN else "java"
                for root_dir, dirs, _files in os.walk(extract_dir):
                    if "bin" in dirs:
                        candidate_bin = os.path.join(root_dir, "bin", exe)
                        if os.path.exists(candidate_bin):
                            source_jdk_dir = root_dir
                            break
                    candidate_jre = os.path.join(root_dir, "jre", "bin", exe)
                    if os.path.exists(candidate_jre):
                        source_jdk_dir = root_dir
                        break

                if not source_jdk_dir:
                    raise Exception("下载包内缺失可识别的 Java 目录结构。")

                repair_mode = APP_CONFIG.get("repair_mode", "smart")
                if is_repair and repair_mode == "smart":
                    update_status("正在执行智能修复，补齐并覆盖核心运行目录...")
                    repair_java_home_smart(source_jdk_dir, target_path)
                else:
                    update_status("正在执行完整修复，保证目录结构干净完整...")
                    replace_java_home_atomically(source_jdk_dir, target_path)
                synced = JavaRegistryAdapter.sync_runtime_registration(target_path, preferred_name=preferred_registry_name)
                if synced:
                    logging.info("修复后已同步注册信息: %s -> %s", target_path, synced)

                self.root.after(0, top.destroy)
                if is_repair:
                    done_text = "智能修复完成。" if APP_CONFIG.get("repair_mode", "smart") == "smart" else "完整修复完成。"
                else:
                    done_text = "物理文件已完成热更新覆盖。"
                self.root.after(0, lambda: messagebox.showinfo("指令完成", done_text))
                self.root.after(0, self.refresh_all_data)
            except Exception as exc:
