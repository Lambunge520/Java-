def resolve_download_sha256(info):
    if not APP_CONFIG.get("verify_download_sha256", True):
        return ""
    checksum = clean_sha256(info.get("sha256"))
    if checksum:
        return checksum
    asset_name = normalize_text(info.get("asset_name") or os.path.basename(urlparse(normalize_text(info.get("url"))).path))
    for checksum_url in info.get("sha256_urls", []) or []:
        try:
            urls = build_github_url_variants(checksum_url) if is_github_like_url(checksum_url) else [checksum_url]
            text = NetworkEngine.request_text_from_candidates(urls, timeout=6, retries=1, cache_ttl=600)
            checksum = parse_sha256_from_text(text, filename=asset_name)
            if checksum:
                return checksum
        except Exception as exc:
            logging.warning("读取 SHA256 校验文件失败: %s - %s", checksum_url, exc)
    return ""


def extract_version_from_filename(text, fallback_major=None):
    value = normalize_text(text)
    if not value:
        return f"JDK {fallback_major}" if fallback_major else "未知版本"
    patterns = [
        r"(\d+\.\d+\.\d+\.\d+)",
        r"(\d+\.\d+\.\d+\+\d+)",
        r"(\d+\.\d+\.\d+)",
        r"(\d+\+\d+)",
    ]
    for pattern in patterns:
        match = re.search(pattern, value)
        if match:
            return match.group(1)
    return f"JDK {fallback_major}" if fallback_major else value


def is_within_directory(base_dir, target_path):
    base_dir = os.path.abspath(base_dir)
    target_path = os.path.abspath(target_path)
    try:
        return os.path.commonpath([base_dir, target_path]) == base_dir
    except ValueError:
        return False


def safe_extract_zip(zip_ref, extract_dir):
    for member in zip_ref.infolist():
        target_path = os.path.abspath(os.path.join(extract_dir, member.filename))
        if not is_within_directory(extract_dir, target_path):
            raise Exception("压缩包包含越界路径，已阻止解压。")
    zip_ref.extractall(extract_dir)


def safe_extract_tar(tar_ref, extract_dir):
    for member in tar_ref.getmembers():
        if member.issym() or member.islnk():
            raise Exception("压缩包包含链接文件，已阻止解压。")
        target_path = os.path.abspath(os.path.join(extract_dir, member.name))
        if not is_within_directory(extract_dir, target_path):
            raise Exception("压缩包包含越界路径，已阻止解压。")
    tar_ref.extractall(extract_dir)


def find_source_jdk_dir(extract_dir):
