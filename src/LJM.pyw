    def rebuild_main_ui(self):
        try:
            if self.tray_icon:
                self.tray_icon.destroy()
                self.tray_icon = None
        except Exception as exc:
            logging.debug("重建界面时销毁托盘失败: %s", exc)
        for child in list(self.root.winfo_children()):
            try:
                child.destroy()
            except Exception:
                pass
        self.root.title(tr("app_title", version=VERSION))
        self.fix_items.clear()
        self.update_items.clear()
        self.move_items.clear()
        self.delete_items.clear()
        self.search_var = None
        self.setup_ui()
        self._setup_tray_icon()
        self.apply_theme(APP_CONFIG.get("theme", "暗粉色"))
        self.refresh_all_data()

