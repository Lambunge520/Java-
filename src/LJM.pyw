                    os.remove(temp_archive)
                if extract_dir and os.path.exists(extract_dir):
                    shutil.rmtree(extract_dir, ignore_errors=True)

        threading.Thread(target=task, daemon=True).start()

    def download_and_extract_popup(self, vendor, major_version, target_path, is_repair=False, preferred_registry_name=None):
        top = tk.Toplevel(self.root)
        self._configure_popup(top, "正在进行底层通信...", 520, 200, min_w=420, min_h=180, max_w_ratio=0.74, max_h_ratio=0.4, resizable=False)
        top.grab_set()

        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, mode="determinate")
        progress.pack(fill=tk.X, padx=24, pady=(22, 12))
        status_label = tk.Label(top, text="正在连接供应商更新源...", justify="center", wraplength=460)
        status_label.pack(fill=tk.X, padx=16)
        self._traverse_and_paint(top)

        def update_progress(percent, downloaded, total):
            self.root.after(0, lambda: progress.config(value=percent))
