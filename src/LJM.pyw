    def _tool_direct_asset_exts(self):
        exts = []
        if APP_EXT:
            exts.append(APP_EXT)
        if IS_WIN:
            exts.append(".exe")
        if not getattr(sys, "frozen", False):
            exts.extend([".pyw", ".py"])
        return unique_sequence(exts)

    def _tool_archive_asset_exts(self):
        return (".zip", ".tar.gz", ".tgz")

    def _tool_asset_has_suffix(self, name, suffix):
        lower = normalize_text(name).lower()
        return lower.endswith(suffix)

    def _tool_asset_platform_score(self, name):
        lower = normalize_text(name).lower()
        score = 0
        if IS_WIN:
            current_os = ("windows", "win64", "win32")
            foreign_os = ("linux", "macos", "darwin", "osx")
        elif sys.platform == "darwin":
            current_os = ("macos", "darwin", "osx", "mac")
            foreign_os = ("windows", "win64", "win32", "linux")
        else:
            current_os = ("linux", "ubuntu", "debian", "appimage")
            foreign_os = ("windows", "win64", "win32", "macos", "darwin", "osx")

        has_current_os = any(token in lower for token in current_os)
        has_foreign_os = any(token in lower for token in foreign_os)
        if has_foreign_os and not has_current_os:
            return -1000
        if has_current_os:
            score += 20

        if APP_ARCH in ("amd64", "x86_64", "x64"):
            current_arch = ("x64", "amd64", "x86_64")
            foreign_arch = ("arm64", "aarch64", "win32", "i386", "i686")
        elif APP_ARCH in ("arm64", "aarch64"):
            current_arch = ("arm64", "aarch64")
            foreign_arch = ("x64", "amd64", "x86_64", "win32", "i386", "i686")
        else:
            current_arch = ("win32", "i386", "i686", "x86")
            foreign_arch = ("x64", "amd64", "x86_64", "arm64", "aarch64")

        has_current_arch = any(token in lower for token in current_arch)
        has_foreign_arch = any(token in lower for token in foreign_arch)
        if has_foreign_arch and not has_current_arch:
            return -1000
        if has_current_arch:
            score += 10

        current_stem = os.path.splitext(os.path.basename(APP_EXECUTABLE_PATH))[0].lower()
        asset_stem = os.path.splitext(os.path.basename(lower))[0].lower()
        if asset_stem == current_stem:
            score += 12
        elif current_stem and current_stem in asset_stem:
            score += 6
        if "ljm" in lower or "java" in lower:
            score += 2
        return score

    def _pick_tool_asset_url(self, assets):
        def ranked_assets(exts):
            ranked = []
            for asset in assets:
                name = normalize_text(asset.get("name"))
                if not name:
                    continue
                lower = name.lower()
                if not any(self._tool_asset_has_suffix(lower, ext) for ext in exts):
                    continue
                score = self._tool_asset_platform_score(lower)
                if score < 0:
                    continue
                ranked.append((score, name, asset))
            ranked.sort(key=lambda item: (item[0], item[1]), reverse=True)
            return ranked

        for _score, _name, asset in ranked_assets(self._tool_direct_asset_exts()):
            url = asset.get("browser_download_url")
            if url:
                return url

        for _score, _name, asset in ranked_assets(self._tool_archive_asset_exts()):
            url = asset.get("browser_download_url")
            if url:
                return url
        return None

    def _detect_tool_update_package_type(self, path, source_url):
        lower = normalize_text(source_url).lower()
        parsed_path = urlparse(lower).path
        if parsed_path.endswith((".tar.gz", ".tgz")):
            return "tar"
        if parsed_path.endswith(".zip"):
            return "zip"
        try:
            if zipfile.is_zipfile(path):
                return "zip"
        except Exception:
            pass
        try:
            if tarfile.is_tarfile(path):
                return "tar"
        except Exception:
            pass
        return ""

    def _self_update_payload_exts(self):
        if getattr(sys, "frozen", False):
            return [APP_EXT] if APP_EXT else [""]
        exts = []
        if APP_EXT:
            exts.append(APP_EXT)
        exts.extend([".pyw", ".py"])
        return unique_sequence(exts)

    def _score_self_update_payload(self, path, extract_dir):
        if not os.path.isfile(path) or os.path.getsize(path) <= 0:
            return None
        rel_path = os.path.relpath(path, extract_dir)
        rel_lower = rel_path.replace("\\", "/").lower()
        if "__macosx/" in rel_lower or rel_lower.startswith("__macosx/"):
            return None

        name = os.path.basename(path).lower()
        stem, ext = os.path.splitext(name)
        allowed_exts = self._self_update_payload_exts()
        if ext not in allowed_exts and not ("" in allowed_exts and "." not in name):
            return None

        platform_score = self._tool_asset_platform_score(rel_lower)
        if platform_score < 0:
            return None

        current_name = os.path.basename(APP_EXECUTABLE_PATH).lower()
        current_stem = os.path.splitext(current_name)[0]
        has_name_hint = (
            name == current_name
            or stem == current_stem
            or (current_stem and current_stem in stem)
            or "ljm" in stem
            or ("java" in stem and "manager" in rel_lower)
        )
        if not has_name_hint:
            return None

        score = platform_score
        if name == current_name:
            score += 60
        elif stem == current_stem:
            score += 45
        elif current_stem and current_stem in stem:
            score += 20
        if APP_EXT and ext == APP_EXT:
            score += 18
        if "ljm" in stem or ("java" in stem and "manager" in rel_lower):
            score += 8
        score -= rel_lower.count("/")
        return score

    def _find_self_update_payload(self, extract_dir):
        candidates = []
        for root_dir, _dirs, files in os.walk(extract_dir):
            for filename in files:
                path = os.path.join(root_dir, filename)
                score = self._score_self_update_payload(path, extract_dir)
                if score is not None:
                    candidates.append((score, path))
        if not candidates:
            raise Exception(tr("self_update_no_payload"))
        candidates.sort(key=lambda item: item[0], reverse=True)
        return candidates[0][1]

    def _self_update_target_dir(self):
        if sys.platform == "darwin":
            current = APP_EXECUTABLE_PATH
            while current and current != os.path.dirname(current):
                if current.lower().endswith(".app"):
                    return current
                current = os.path.dirname(current)
        return APP_DIR

    def _self_update_bundle_dir(self, payload_path, extract_dir):
        if sys.platform == "darwin":
            current = payload_path
            while current and is_within_directory(extract_dir, current):
                if current.lower().endswith(".app"):
                    return current
                parent = os.path.dirname(current)
                if parent == current:
                    break
                current = parent
        return os.path.dirname(payload_path)

    def _stage_self_update_payload(self, downloaded_path, source_url, staged_path, status_cb):
        package_type = self._detect_tool_update_package_type(downloaded_path, source_url)
        if not package_type:
            shutil.move(downloaded_path, staged_path)
            return "", ""

        status_cb(tr("self_update_extracting"))
        extract_dir = tempfile.mkdtemp(prefix="ljm_tool_update_extract_")
        try:
            if package_type == "tar":
                with tarfile.open(downloaded_path, "r:*") as tar_ref:
                    safe_extract_tar(tar_ref, extract_dir)
            else:
                with zipfile.ZipFile(downloaded_path, "r") as zip_ref:
                    safe_extract_zip(zip_ref, extract_dir)

            payload_path = self._find_self_update_payload(extract_dir)
            if os.path.exists(staged_path):
                os.remove(staged_path)
            shutil.copy2(payload_path, staged_path)
            if not IS_WIN:
                try:
                    os.chmod(staged_path, os.stat(staged_path).st_mode | 0o755)
                except Exception:
                    pass
            return self._self_update_bundle_dir(payload_path, extract_dir), extract_dir
        except Exception:
            shutil.rmtree(extract_dir, ignore_errors=True)
            raise

    def check_tool_update(self):
        def task():
            try:
                data = None
                for endpoint in self._tool_update_endpoints():
                    try:
                        data = NetworkEngine.request_json(endpoint, timeout=8, retries=2, cache_ttl=180)
                        if data:
                            break
                    except Exception as exc:
                        logging.warning("工具更新接口失败: %s - %s", endpoint, exc)
                if not data:
                    raise Exception("未能获取工具更新信息。")

                latest_ver = normalize_text(data.get("tag_name"))
                if latest_ver and parse_app_version(latest_ver) > parse_app_version(VERSION):
                    asset_url = self._pick_tool_asset_url(data.get("assets", []))
                    if asset_url:
                        self.root.after(0, lambda: self.prompt_tool_update(latest_ver, asset_url))
                    else:
                        self.root.after(0, lambda: messagebox.showinfo(tr("tool_update_hint_title"), tr("tool_update_no_asset", version=latest_ver)))
                else:
                    self.root.after(0, lambda: messagebox.showinfo(tr("tool_update_check_title"), tr("tool_update_latest")))
            except Exception as exc:
                logging.error("检查工具更新失败: %s", exc)
                self.root.after(0, lambda: messagebox.showerror(tr("tool_update_error_title"), tr("tool_update_error")))

        threading.Thread(target=task, daemon=True).start()

