                    return result
            except Exception as exc:
                logging.warning("Semeru GitHub 源失败: repo=%s error=%s", repo, exc)
        if mirrors_only:
            return None
        return JavaDownloadEngine._fetch_adoptium_api(major_version, "openj9", "IBM Semeru OpenJ9")

    @staticmethod
    def _fetch_zulu(major_version):
