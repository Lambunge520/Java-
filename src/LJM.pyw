                self.root.after(0, lambda: messagebox.showerror("网络阻断", f"发生中断:\n{exc}"))
            finally:
                if temp_archive and os.path.exists(temp_archive):
                    os.remove(temp_archive)
                if extract_dir and os.path.exists(extract_dir):
                    shutil.rmtree(extract_dir, ignore_errors=True)

        threading.Thread(target=task, daemon=True).start()

    def download_and_extract_popup_v2(self, vendor, major_version, target_path, is_repair=False, preferred_registry_name=None):
        top = tk.Toplevel(self.root)
        title = tr("transfer_title_repair") if is_repair else tr("transfer_title_update")
        self._configure_popup(top, title, 540, 220, min_w=440, min_h=190, max_w_ratio=0.76, max_h_ratio=0.42, resizable=False)
        top.grab_set()
        self._begin_active_transfer()

        cancel_event = threading.Event()
        finished_state = {"done": False}

        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, mode="determinate")
        progress.pack(fill=tk.X, padx=24, pady=(22, 12))
        status_label = tk.Label(top, text=tr("connecting_vendor"), justify="center", wraplength=470)
        status_label.pack(fill=tk.X, padx=16, pady=(0, 10))

        button_frame = tk.Frame(top, bg=self.current_bg)
        button_frame.pack(fill=tk.X, padx=20, pady=(0, 16))
        cancel_text = tr("cancel_repair") if is_repair else tr("cancel_update")
        cancel_button = tk.Button(button_frame, text=cancel_text, width=14)
        cancel_button.pack(side=tk.RIGHT)
        self._traverse_and_paint(top)

        def mark_finished():
            if finished_state["done"]:
                return
            finished_state["done"] = True
            self._end_active_transfer()

        def request_cancel():
            if finished_state["done"] or cancel_event.is_set():
                return
            cancel_event.set()
            cancel_button.config(state=tk.DISABLED, text=tr("canceling"))
            status_label.config(text=tr("cancel_requested"))

        cancel_button.config(command=request_cancel)
        top.protocol("WM_DELETE_WINDOW", request_cancel)

        def update_progress(percent, downloaded, total):
            self.root.after(0, lambda: progress.config(value=percent))
            if total > 0:
                text = tr("download_progress_total", downloaded=downloaded / 1024 / 1024, total=total / 1024 / 1024)
            else:
                text = tr("download_progress", downloaded=downloaded / 1024 / 1024)
            self.root.after(0, lambda: status_label.config(text=text))

        def update_status(message):
            self.root.after(0, lambda: status_label.config(text=message))

        def task():
            info = None
            temp_archive = ""
            extract_dir = ""
            backup_dir = ""
            temp_archive_is_cache = False
            archive_verified = False
            modification_started = False
            try:
                ensure_not_cancelled(cancel_event)
                info = JavaDownloadEngine.get_latest_download_info(vendor, major_version)
                if not info:
                    raise Exception(tr("metadata_missing"))

                suffix = download_info_archive_suffix(info)
                expected_sha256 = resolve_download_sha256(info)
                if APP_CONFIG.get("download_cache_enabled", True):
                    temp_archive = archive_cache_path(info, suffix)
                    temp_archive_is_cache = True
                    if os.path.exists(temp_archive) and not archive_quick_check(temp_archive, suffix):
                        remove_cached_archive(temp_archive)
                else:
                    fd, temp_archive = tempfile.mkstemp(suffix=suffix)
                    os.close(fd)

                update_status(tr("source_locked", source=info.get("source", "Unknown")))
                download_urls = info.get("urls") or [info["url"]]
                source_url = NetworkEngine.download_from_candidates(
                    download_urls,
                    temp_archive,
                    update_progress,
                    update_status,
                    cancel_event=cancel_event,
                    expected_sha256=expected_sha256,
                    reuse_existing=temp_archive_is_cache,
                )
                if APP_CONFIG.get("verify_download_sha256", True) and expected_sha256:
                    verify_file_sha256(temp_archive, expected_sha256, cancel_event=cancel_event)
                if not archive_quick_check(temp_archive, suffix):
                    remove_cached_archive(temp_archive)
                    raise Exception("下载包结构校验失败，已丢弃损坏缓存，请重试。")
                archive_verified = True
                if temp_archive_is_cache:
                    write_archive_metadata(temp_archive, info, source_url, expected_sha256)

                ensure_not_cancelled(cancel_event)
                self.root.after(0, lambda: progress.config(mode="indeterminate"))
                self.root.after(0, progress.start)
                update_status(tr("verifying_extracting"))

                extract_dir = tempfile.mkdtemp()
                if suffix == ".tar.gz":
                    with tarfile.open(temp_archive, "r:gz") as tar_ref:
                        safe_extract_tar(tar_ref, extract_dir)
                else:
                    with zipfile.ZipFile(temp_archive, "r") as zip_ref:
                        safe_extract_zip(zip_ref, extract_dir)

                ensure_not_cancelled(cancel_event)
                source_jdk_dir = None
                exe = "java.exe" if IS_WIN else "java"
                for root_dir, dirs, _files in os.walk(extract_dir):
                    ensure_not_cancelled(cancel_event)
                    if "bin" in dirs:
                        candidate_bin = os.path.join(root_dir, "bin", exe)
                        if os.path.exists(candidate_bin):
                            source_jdk_dir = root_dir
                            break
                    candidate_jre = os.path.join(root_dir, "jre", "bin", exe)
                    if os.path.exists(candidate_jre):
                        source_jdk_dir = root_dir
                        break

                if not source_jdk_dir:
                    raise Exception(tr("missing_java_structure"))

                active_processes = find_processes_using_java_home(target_path)
                if active_processes:
                    detail = "\n".join(active_processes[:5])
                    raise Exception(tr("target_in_use_error", detail=detail))

                if APP_CONFIG.get("backup_before_changes", True):
                    update_status(tr("creating_backup"))
                    backup_dir = create_java_backup(target_path, "repair" if is_repair else "update", cancel_event=cancel_event)

                repair_mode = APP_CONFIG.get("repair_mode", "smart")
                modification_started = True
                if is_repair and repair_mode == "smart":
                    update_status(tr("smart_repair_running"))
                    repair_java_home_smart(source_jdk_dir, target_path, cancel_event=cancel_event)
                else:
                    update_status(tr("full_update_running"))
                    replace_java_home_atomically(source_jdk_dir, target_path, cancel_event=cancel_event)
                ensure_not_cancelled(cancel_event)
                synced = JavaRegistryAdapter.sync_runtime_registration(target_path, preferred_name=preferred_registry_name)
                if synced:
                    logging.info("修复/更新后已同步注册信息: %s -> %s", target_path, synced)

                mark_finished()
                self.root.after(0, top.destroy)
                if is_repair:
                    done_text = tr("smart_repair_done") if APP_CONFIG.get("repair_mode", "smart") == "smart" else tr("full_repair_done")
                else:
                    done_text = tr("update_done")
                self.root.after(0, lambda: messagebox.showinfo(tr("task_done_title"), done_text))
                self.root.after(0, self.refresh_all_data)
            except OperationCancelled:
                logging.info("任务已取消: vendor=%s major=%s path=%s", vendor, major_version, target_path)
                mark_finished()
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showinfo(tr("task_cancelled_title"), tr("task_cancelled_text")))
            except Exception as exc:
                logging.error("下载或解压失败: %s\n%s", exc, traceback.format_exc())
                rollback_text = ""
                if backup_dir and modification_started:
                    try:
                        restore_java_backup(backup_dir)
                        rollback_text = tr("rollback_auto_done")
                    except Exception as rollback_exc:
                        logging.error("自动回滚失败: %s", rollback_exc)
                        rollback_text = tr("rollback_auto_failed")
                if temp_archive_is_cache and not archive_verified:
                    remove_cached_archive(temp_archive)
                mark_finished()
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showerror(tr("task_interrupted_title"), tr("task_interrupted_text", error=exc, rollback=rollback_text)))
            finally:
                mark_finished()
                if temp_archive and os.path.exists(temp_archive) and not temp_archive_is_cache:
                    os.remove(temp_archive)
                if extract_dir and os.path.exists(extract_dir):
                    shutil.rmtree(extract_dir, ignore_errors=True)

        threading.Thread(target=task, daemon=True).start()

    def cloud_repair_java(self):
        selected = self.tree_fix.selection()
        if not selected:
            return messagebox.showwarning(tr("no_selection_repair_title"), tr("no_selection_repair_text"))
        item = self.tree_fix.item(selected[0])["values"]
        meta = self.fix_items.get(selected[0], {})
        preferred_name = meta.get("registry_name") or build_registry_name(read_java_runtime_info(item[2]))
        repair_mode_label = self._repair_mode_label()
        if not self._confirm_process_usage(item[2], repair_mode_label):
            return
        if messagebox.askyesno(tr("confirm_repair_title"), tr("confirm_repair_text", mode=repair_mode_label, path=item[2])):
            self.download_and_extract(item[1], item[0], item[2], is_repair=True, preferred_registry_name=preferred_name)

    def _set_update_row(self, item_id, latest_version, has_update_text):
        if item_id not in self.tree_up.get_children():
            return
        self.tree_up.set(item_id, "new_ver", latest_version)
        self.tree_up.set(item_id, "has_update", has_update_text)

    def check_all_updates(self):
        NetworkEngine.maybe_refresh_mirror_speed_order_async()
        item_ids = list(self.tree_up.get_children())
        if not item_ids:
            return

        NetworkEngine.apply_proxy_settings()
        for item_id in item_ids:
            self._set_update_row(item_id, "数据获取中...", "")

        def worker(item_id):
            runtime = self.update_items.get(item_id)
            if not runtime:
                return
            try:
                info = JavaDownloadEngine.get_latest_download_info(runtime["vendor"], runtime["major"])
                if not info:
                    self.root.after(0, lambda iid=item_id: self._set_update_row(iid, "更新源不可用", "否"))
                    return
                latest_version = version_display_text(info["version"])
                has_update = "是" if is_update_available(runtime["version"], latest_version, runtime["major"]) else "否"
                self.root.after(0, lambda iid=item_id, lv=latest_version, hu=has_update: self._set_update_row(iid, lv, hu))
            except Exception as exc:
                logging.error("更新检测线程异常: %s", exc)
                self.root.after(0, lambda iid=item_id: self._set_update_row(iid, "网络错误", "否"))

        executor = concurrent.futures.ThreadPoolExecutor(max_workers=min(6, len(item_ids)))
        for item_id in item_ids:
            executor.submit(worker, item_id)
        executor.shutdown(wait=False)

    def perform_update(self):
        selected = self.tree_up.selection()
        if not selected:
            return
        item_id = selected[0]
        runtime = self.update_items.get(item_id)
        if not runtime:
            return
        item = self.tree_up.item(item_id)["values"]
        if not self._confirm_process_usage(runtime["java_home"], tr("perform_update")):
            return
        if messagebox.askyesno(
            tr("confirm_update_title"),
            tr("confirm_update_text", path=item[1]),
        ):
            self.download_and_extract(runtime["vendor"], runtime["major"], runtime["java_home"], is_repair=False, preferred_registry_name=runtime.get("registry_name"))


if __name__ == "__main__":
    NetworkEngine.apply_proxy_settings()
    pending_single_instance_show = {"requested": False, "callback": None}

    def handle_single_instance_show():
        callback = pending_single_instance_show.get("callback")
        if callback:
            callback()
        else:
            pending_single_instance_show["requested"] = True

    single_instance_guard = SingleInstanceGuard(single_instance_port(APP_SOURCE_ROOT), on_show=handle_single_instance_show)
    if not single_instance_guard.acquire():
        if notify_existing_instance(single_instance_guard.port):
            logging.info("检测到已有 LJM 实例，已发送唤醒请求并退出当前进程。")
            sys.exit(0)
        logging.warning("单实例端口被占用但唤醒失败，继续启动当前进程。")
        single_instance_guard = None

    root = tk.Tk()
    root.withdraw()
    app = JavaManagerApp(root)
    app.single_instance_guard = single_instance_guard
    if single_instance_guard:
        pending_single_instance_show["callback"] = lambda: root.after(0, app.bring_to_front)
        if pending_single_instance_show.get("requested"):
            pending_single_instance_show["callback"]()
    root.update_idletasks()
    if APP_CONFIG.get("start_minimized_to_tray", False):
        app.hide_to_tray()
    else:
        root.deiconify()
        root.state("normal")
        root.lift()
        root.focus_force()
        root.attributes("-topmost", True)
        root.after(100, lambda: root.attributes("-topmost", False))
    if IS_WIN and not APP_CONFIG.get("start_minimized_to_tray", False):
        def win_show():
            try:
                hwnd = ctypes.windll.user32.GetParent(root.winfo_id())
                if hwnd:
                    ctypes.windll.user32.ShowWindow(hwnd, 1)
                    ctypes.windll.user32.SetForegroundWindow(hwnd)
            except Exception:
                pass

        root.after(50, win_show)
    logging.info("主窗口已显示")
    root.mainloop()
