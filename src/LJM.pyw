    version = (
        release.get("JAVA_RUNTIME_VERSION")
        or release.get("JAVA_VERSION")
        or normalize_text(os.path.basename(java_home))
        or "未知版本"
    )
    major = extract_major_from_version(version, fallback="17")
    content = " ".join(f"{k}={v}" for k, v in release.items()).upper()
    vendor = "Generic OpenJDK"
    jvm_impl = "hotspot"

    if "OPENJ9" in content or "SEMERU" in content or "IBM" in content:
        vendor = "IBM Semeru OpenJ9"
        jvm_impl = "openj9"
    elif "GRAALVM" in content:
        vendor = "GraalVM"
    elif "ZULU" in content or "AZUL" in content:
        vendor = "Azul Zulu"
    elif "MICROSOFT" in content:
        vendor = "Microsoft Build of OpenJDK"
    elif "ORACLE" in content:
        vendor = "Oracle Java"
    elif "DRAGONWELL" in content or "ALIBABA" in content:
        vendor = "Alibaba Dragonwell"
    elif "TEMURIN" in content or "ADOPTIUM" in content:
        vendor = "Eclipse Temurin"

    return {
        "java_home": java_home,
        "version": version,
        "major": major,
        "vendor": vendor,
        "jvm_impl": jvm_impl,
        "release": release,
    }


def version_display_text(version_text):
    text = normalize_text(version_text)
    return text if text else "未知"


def sanitize_registry_name(value):
    text = normalize_text(value)
    if not text:
        return "JDK_Unknown"
    text = re.sub(r'[<>:"/\\|?*]+', "_", text)
    text = re.sub(r"\s+", "_", text)
    return text[:120]


