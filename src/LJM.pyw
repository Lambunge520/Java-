    def _background_interval_seconds(self):
        mode = APP_CONFIG.get("background_update_check", "weekly")
        if mode == "daily":
            return 24 * 60 * 60
        if mode == "weekly":
            return 7 * 24 * 60 * 60
        return 0

    def _schedule_background_update_check(self, initial=False):
        if self._background_update_job:
            try:
                self.root.after_cancel(self._background_update_job)
            except Exception:
                pass
            self._background_update_job = None

        interval = self._background_interval_seconds()
        if interval <= 0:
            return

        now = time.time()
        last_check = float(APP_CONFIG.get("last_background_update_check", 0) or 0)
        due_in = max(0, interval - (now - last_check))
        if initial and due_in <= 0:
            delay_ms = 7000
        else:
            delay_ms = int(min(max(due_in, 60), 60 * 60) * 1000)
        self._background_update_job = self.root.after(delay_ms, self._run_background_update_check)

    def _collect_runtime_rows_for_background(self):
        rows = list(self._java_rows)
        if rows:
            return rows
        collected = []
        for version_name, java_home in JavaRegistryAdapter.get_all():
            report = get_java_health_report(java_home)
            runtime = read_java_runtime_info(java_home)
            collected.append(
                {
                    "version_name": version_name,
                    "java_home": java_home,
                    "runtime": runtime,
                    "report": report,
                    "status": report["status"],
                }
            )
        return collected

    def _run_background_update_check(self):
        self._background_update_job = None
        if self._background_update_running or self._active_transfer_count > 0:
            self._schedule_background_update_check(initial=False)
            return
        if self._background_interval_seconds() <= 0:
            return
        self._background_update_running = True

        def worker():
            updates = []
            try:
                NetworkEngine.maybe_refresh_mirror_speed_order_async()
                for row in self._collect_runtime_rows_for_background():
                    if not row.get("report", {}).get("usable"):
                        continue
                    runtime = row.get("runtime", {})
                    info = JavaDownloadEngine.get_latest_download_info(runtime.get("vendor"), runtime.get("major"))
                    if not info:
                        continue
                    latest_version = version_display_text(info.get("version"))
                    if is_update_available(runtime.get("version"), latest_version, runtime.get("major")):
                        updates.append(f"{runtime.get('vendor')} {runtime.get('major')} -> {latest_version}")
                APP_CONFIG["last_background_update_check"] = time.time()
                save_config(APP_CONFIG)
                if updates:
                    message = tr("background_update_prefix", items="\n".join(updates[:8]))
                    if len(updates) > 8:
                        message += tr("background_update_more", count=len(updates) - 8)
                    self.root.after(0, lambda: messagebox.showinfo(tr("background_update_title"), message))
            except Exception as exc:
                logging.warning("后台 Java 更新提醒失败: %s", exc)
            finally:
                self._background_update_running = False
                self.root.after(0, lambda: self._schedule_background_update_check(initial=False))

        threading.Thread(target=worker, daemon=True).start()

    def _confirm_process_usage(self, target_path, action_text):
        processes = find_processes_using_java_home(target_path)
        if not processes:
            return True
        detail = "\n".join(processes[:5])
        if len(processes) > 5:
            detail += f"\n...另有 {len(processes) - 5} 个相关进程"
        return messagebox.askyesno(
            tr("process_usage_title"),
            tr("process_usage_text", path=target_path, detail=detail, action=action_text),
        )

    def _begin_active_transfer(self):
        self._active_transfer_count += 1

    def _end_active_transfer(self):
        self._active_transfer_count = max(0, self._active_transfer_count - 1)

    def _on_root_focus_out(self, _event=None):
        self._window_has_focus = False

    def _on_root_focus_in(self, _event=None):
        if self._window_has_focus:
            return
        self._window_has_focus = True
        if self._focus_refresh_job:
            try:
                self.root.after_cancel(self._focus_refresh_job)
            except Exception:
                pass
        self._focus_refresh_job = self.root.after(220, self._refresh_after_focus_gain)

    def _refresh_after_focus_gain(self):
        self._focus_refresh_job = None
        if self._active_transfer_count > 0:
            return
        try:
            self.refresh_all_data()
            selected_tab = self.notebook.select()
            if selected_tab == str(self.tab_update):
                self.check_all_updates()
        except Exception as exc:
            logging.debug("焦点恢复后自动刷新失败: %s", exc)

