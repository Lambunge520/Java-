    @staticmethod
    def _fetch_adoptium_api(major_version, jvm_impl, vendor):
        os_type = platform_os()
        arch = ARCH_INFO["adoptium"]
        base = "https://api.adoptium.net"
        url = f"{base}/v3/assets/latest/{major_version}/{jvm_impl}?os={os_type}&architecture={arch}&image_type=jdk"
        data = NetworkEngine.request_json(url, timeout=4, retries=1, cache_ttl=300)
        if not isinstance(data, list) or not data:
            return None
        asset = data[0]
        package_info = asset.get("binary", {}).get("package", {})
        version = (
            asset.get("version", {}).get("openjdk_version")
            or asset.get("release_name")
            or package_info.get("name")
            or f"JDK {major_version}"
        )
        download_url = package_info.get("link")
        if not download_url:
            return None
        return JavaDownloadEngine._make_result(
            version,
            download_url,
            f"Adoptium API {jvm_impl}",
            vendor,
            sha256=package_info.get("checksum"),
            sha256_urls=[package_info.get("checksum_link")],
            asset_name=package_info.get("name", ""),
        )

