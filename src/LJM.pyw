    def execute_self_update_popup(self, url):
        top = tk.Toplevel(self.root)
        self._configure_popup(top, tr("self_update_title"), 460, 170, min_w=380, min_h=150, max_w_ratio=0.7, max_h_ratio=0.35, resizable=False)

        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, mode="determinate")
        progress.pack(fill=tk.X, padx=20, pady=(20, 12))
        status_label = tk.Label(top, text=tr("self_update_status"), justify="center", wraplength=400)
        status_label.pack(fill=tk.X, padx=16)
        self._traverse_and_paint(top)

        def update_progress(percent, downloaded, total):
            progress.config(value=percent)
            if total > 0:
                status_label.config(text=f"下载中: {downloaded / 1024 / 1024:.1f} MB / {total / 1024 / 1024:.1f} MB")
            else:
                status_label.config(text=f"下载中: {downloaded / 1024 / 1024:.1f} MB")

        def update_status(message):
            self.root.after(0, lambda: status_label.config(text=message))

        def dl_task():
            temp_download = os.path.join(tempfile.gettempdir(), f"ljm_tool_update_{os.getpid()}_{int(time.time())}.download")
            temp_new = APP_EXECUTABLE_PATH + ".new"
            bundle_dir = ""
            cleanup_dir = ""
            try:
                if os.path.exists(temp_new):
                    os.remove(temp_new)
                update_urls = build_github_url_variants(url) if is_github_like_url(url) else [url]
                used_url = NetworkEngine.download_from_candidates(update_urls, temp_download, lambda *args: self.root.after(0, lambda: update_progress(*args)), update_status)
                bundle_dir, cleanup_dir = self._stage_self_update_payload(temp_download, used_url or url, temp_new, update_status)
                try:
                    if os.path.exists(temp_download):
                        os.remove(temp_download)
                except Exception:
                    pass
                target_dir = self._self_update_target_dir()
                launch_command = app_launch_command()
                if IS_WIN:
                    bat_path = os.path.join(tempfile.gettempdir(), "update_java_mgr.bat")
                    with open(bat_path, "w", encoding="gbk") as f:
                        if bundle_dir:
                            f.write(
                                "@echo off\n"
                                "timeout /t 1 /nobreak >nul\n"
                                f'xcopy /E /I /Y /H /C /Q "{os.path.join(bundle_dir, "*")}" "{target_dir}\\" >nul\n'
                                f'move /y "{temp_new}" "{APP_EXECUTABLE_PATH}"\n'
                            )
                        else:
                            f.write(
                                "@echo off\n"
                                "timeout /t 1 /nobreak >nul\n"
                                f'move /y "{temp_new}" "{APP_EXECUTABLE_PATH}"\n'
                            )
                        if cleanup_dir:
                            f.write(f'rmdir /s /q "{cleanup_dir}"\n')
                        f.write(
                            f"start \"\" {launch_command}\n"
                            'del "%~f0"\n'
                        )
                    os.startfile(bat_path)
                else:
                    sh_path = os.path.join(tempfile.gettempdir(), "update_java_mgr.sh")
                    q_temp_new = shlex.quote(temp_new)
                    q_app_path = shlex.quote(APP_EXECUTABLE_PATH)
                    q_target_dir = shlex.quote(target_dir)
                    with open(sh_path, "w", encoding="utf-8") as f:
                        f.write("#!/bin/sh\nsleep 1\n")
                        if bundle_dir:
                            f.write(f"cp -R {shlex.quote(bundle_dir)}/. {q_target_dir}/\n")
                        f.write(f"mv -f {q_temp_new} {q_app_path}\n")
                        f.write(f"chmod +x {q_app_path}\n")
                        if cleanup_dir:
                            f.write(f"rm -rf {shlex.quote(cleanup_dir)}\n")
                        f.write(f"{launch_command} &\n")
                        f.write('rm "$0"\n')
                    os.system(f'chmod +x "{sh_path}" && "{sh_path}" &')
                self.root.after(0, sys.exit)
            except Exception as exc:
                try:
                    if os.path.exists(temp_download):
                        os.remove(temp_download)
                except Exception:
                    pass
                if cleanup_dir:
                    shutil.rmtree(cleanup_dir, ignore_errors=True)
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showerror(tr("self_update_failed_title"), str(exc)))

        threading.Thread(target=dl_task, daemon=True).start()

    def extract_major_version(self, path):
        return read_java_runtime_info(path)["major"]

    def get_java_type(self, java_home):
        return read_java_runtime_info(java_home)["vendor"]

    def check_java_validity(self, java_home):
        return get_java_health_report(java_home)["status"]

    def _java_filter_query(self):
        if self.search_var is None:
            return ""
        return normalize_text(self.search_var.get()).lower()

    def _row_matches_java_filter(self, row, query):
        return java_row_matches_query(row, query)

    def apply_java_filter(self):
        if not hasattr(self, "lb_reg") or not hasattr(self, "tree_fix") or not hasattr(self, "tree_up"):
            return
        query = self._java_filter_query()
        self.lb_reg.delete(0, tk.END)
        for item_id in self.tree_fix.get_children():
            self.tree_fix.delete(item_id)
        for item_id in self.tree_up.get_children():
            self.tree_up.delete(item_id)
        if hasattr(self, "tree_move"):
            for item_id in self.tree_move.get_children():
                self.tree_move.delete(item_id)
        if hasattr(self, "tree_delete"):
            for item_id in self.tree_delete.get_children():
                self.tree_delete.delete(item_id)
        self.fix_items.clear()
        self.update_items.clear()
        self.move_items.clear()
        self.delete_items.clear()

        for row in self._java_rows:
            if not self._row_matches_java_filter(row, query):
                continue
            runtime = row["runtime"]
            report = row["report"]
            java_home = row["java_home"]
            version_name = row["version_name"]
            mark = row["mark"]
            status = row["status"]
            self.lb_reg.insert(tk.END, f"{mark} {version_name}  [{java_home}]")
            fix_item_id = self.tree_fix.insert("", tk.END, values=(runtime["major"], runtime["vendor"], java_home, status))
            self.fix_items[fix_item_id] = {
                "registry_name": version_name,
                "java_home": java_home,
                "runtime": runtime,
                "report": report,
            }
            if report["usable"]:
                item_id = self.tree_up.insert(
                    "",
                    tk.END,
                    values=(runtime["vendor"], java_home, version_display_text(runtime["version"]), "等待自动检测...", ""),
                )
                runtime_info = dict(runtime)
                runtime_info["registry_name"] = version_name
                runtime_info["health_status"] = status
                self.update_items[item_id] = runtime_info
            if hasattr(self, "tree_move"):
                move_item_id = self.tree_move.insert(
                    "",
                    tk.END,
                    values=(runtime["vendor"], java_home, version_display_text(runtime["version"]), status),
                )
                self.move_items[move_item_id] = {
                    "registry_name": version_name,
                    "java_home": java_home,
                    "runtime": runtime,
                    "report": report,
                }
            if hasattr(self, "tree_delete"):
                delete_item_id = self.tree_delete.insert(
                    "",
                    tk.END,
                    values=(runtime["vendor"], java_home, version_display_text(runtime["version"]), status),
                )
                self.delete_items[delete_item_id] = {
                    "registry_name": version_name,
                    "java_home": java_home,
                    "runtime": runtime,
                    "report": report,
                }
        if hasattr(self, "tree_move"):
            self.refresh_move_target_preview()

    def refresh_all_data(self):
        rows = []
        for version_name, java_home in JavaRegistryAdapter.get_all():
            report = get_java_health_report(java_home)
            status = report["status"]
            runtime = read_java_runtime_info(java_home)
            mark = "[OK]" if report["healthy"] else ("[!]" if report["usable"] else "[X]")
            rows.append(
                {
                    "registry_name": version_name,
                    "version_name": version_name,
                    "java_home": java_home,
                    "runtime": runtime,
                    "report": report,
                    "status": status,
                    "mark": mark,
                }
            )
        self._java_rows = rows
        self.apply_java_filter()

    def scan_folder(self):
        folder_path = filedialog.askdirectory(title="选择包含若干 Java 的父级大文件夹")
        if not folder_path:
            return
        success_count = 0
        for full_path in discover_java_homes([folder_path], max_depth=6):
            runtime = read_java_runtime_info(full_path)
            registry_name = build_registry_name(runtime)
            jvm_path = find_jvm_library(full_path)
            if JavaRegistryAdapter.register(registry_name, full_path, jvm_path):
                success_count += 1
        messagebox.showinfo("扫盘完毕", f"已探测并静默注册 {success_count} 个本地 Java 环境。")
        self.refresh_all_data()

    def unregister_selected(self):
        indices = self.lb_reg.curselection()
        if not indices:
            return
        for index in indices:
            raw = self.lb_reg.get(index)
            version_name = raw.split("  [", 1)[0].replace("[OK]", "").replace("[!]", "").replace("[X]", "").strip()
            JavaRegistryAdapter.unregister(version_name)
        self.refresh_all_data()

