def _dependency_platform_dirs():
    machine = platform.machine().lower()
    if IS_WIN:
        platform_name = "windows"
    elif sys.platform == "darwin":
        platform_name = "macos"
    else:
        platform_name = "linux"

    arch_aliases = [machine]
    if machine in ("amd64", "x86_64"):
        arch_aliases.extend(["x64", "amd64", "x86_64"])
    elif machine in ("arm64", "aarch64"):
        arch_aliases.extend(["arm64", "aarch64"])
    elif machine in ("x86", "i386", "i686"):
        arch_aliases.extend(["x86", "i386", "i686", "win32"])

    arch_candidates = []
    for arch in arch_aliases:
        if arch and arch not in arch_candidates:
            arch_candidates.append(arch)

    deps_root_candidates = [BUNDLED_DEPS_DIR, RESOURCE_DEPS_DIR]
    if SOURCE_DEPS_DIR:
        deps_root_candidates.insert(0, SOURCE_DEPS_DIR)

    deps_roots = []
    for deps_root in deps_root_candidates:
        if deps_root and deps_root not in deps_roots:
            deps_roots.append(deps_root)

    candidates = []
    for deps_root in deps_roots:
        for arch in arch_candidates:
            candidates.append(os.path.join(deps_root, f"{platform_name}-{arch}"))
            candidates.append(os.path.join(deps_root, f"{platform_name}_{arch}"))
        candidates.append(os.path.join(deps_root, platform_name))
        candidates.append(deps_root)
    result = []
    for path in candidates:
        if path and path not in result:
            result.append(path)
    return result


def load_bundled_dependencies():
    for path in reversed(_dependency_platform_dirs()):
        if os.path.isdir(path) and path not in sys.path:
            sys.path.insert(0, path)


def current_dependency_dir():
    fallback = SOURCE_DEPS_DIR or BUNDLED_DEPS_DIR
    for path in _dependency_platform_dirs():
        name = os.path.basename(path).lower()
        if name.startswith(("windows-", "linux-", "macos-")) or name.startswith(("windows_", "linux_", "macos_")):
            if fallback in (BUNDLED_DEPS_DIR, SOURCE_DEPS_DIR):
                fallback = path
            if os.path.isdir(path):
                return path
    return fallback


def writable_dependency_dir():
    resource_deps_abs = os.path.abspath(RESOURCE_DEPS_DIR)
    bundled_deps_abs = os.path.abspath(BUNDLED_DEPS_DIR)
    source_deps_abs = os.path.abspath(SOURCE_DEPS_DIR) if SOURCE_DEPS_DIR else ""
    for path in _dependency_platform_dirs():
        path_abs = os.path.abspath(path)
        if resource_deps_abs != bundled_deps_abs and path_abs.startswith(resource_deps_abs):
            continue
        name = os.path.basename(path).lower()
        if name.startswith(("windows-", "linux-", "macos-")) or name.startswith(("windows_", "linux_", "macos_")):
            return path
    return source_deps_abs or BUNDLED_DEPS_DIR


def install_runtime_dependencies(packages):
    packages = [pkg for pkg in packages if pkg]
    if not packages:
        return True
    target_dir = writable_dependency_dir()
    os.makedirs(target_dir, exist_ok=True)
    for mirror in PYPI_MIRRORS:
        cmd = [
            sys.executable,
            "-m",
            "pip",
            "install",
            "--target",
            target_dir,
            "-i",
            mirror,
            "--timeout",
            "20",
            "--retries",
            "2",
        ] + packages
        try:
            subprocess.check_call(cmd)
            if target_dir not in sys.path:
                sys.path.insert(0, target_dir)
            return True
        except Exception as exc:
            logging.warning("依赖自动下载失败: mirror=%s packages=%s error=%s", mirror, packages, exc)
    return False


def platform_tray_dependency_packages():
    packages = ["pystray", "Pillow"]
    if sys.platform == "darwin":
        packages.extend(["pyobjc-framework-Cocoa", "pyobjc-framework-Quartz"])
    elif not IS_WIN:
        packages.append("python-xlib")
    return packages


