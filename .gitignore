# Local runtime logs and config
*.log
javamanager_config.json
java_virtual_registry.json
ljm_headless_result.json
headless_test_result*.json

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Bundled dependency binaries are release inputs, not cache.
!vendor/deps/**/*.pyd

# PyInstaller output
build/
dist/
*.spec

# Local release archives and checksums
/LJM-Java-Manager*.zip
/LJM-Java-Manager*.tar.gz
/LJM-Java-Manager*.tgz
/LJM-Java-Manager*.exe
/SHA256SUMS*.txt
/release-assets/

# Temporary files
*.tmp
*.new
deps_wheels_tmp/

# IDE/editor noise
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
