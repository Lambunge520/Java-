_EMBEDDED_ICON_PATH = None


def embedded_java_icon_bytes():
    if not JAVA_ICO_BASE64:
        return b""
    try:
        return base64.b64decode(JAVA_ICO_BASE64)
    except Exception as exc:
        logging.error("内置 java.ico 解码失败: %s", exc)
        return b""


def materialize_embedded_java_icon():
    global _EMBEDDED_ICON_PATH
    if _EMBEDDED_ICON_PATH and os.path.exists(_EMBEDDED_ICON_PATH):
        return _EMBEDDED_ICON_PATH

    icon_bytes = embedded_java_icon_bytes()
    if not icon_bytes:
        return ""

    try:
        icon_dir = os.path.join(tempfile.gettempdir(), "ljm_java_manager")
        os.makedirs(icon_dir, exist_ok=True)
        icon_path = os.path.join(icon_dir, "java.ico")
        if not os.path.exists(icon_path) or os.path.getsize(icon_path) != len(icon_bytes):
            with open(icon_path, "wb") as f:
                f.write(icon_bytes)
        _EMBEDDED_ICON_PATH = icon_path
        return icon_path
    except Exception as exc:
        logging.error("释放内置 java.ico 失败: %s", exc)
        return ""


