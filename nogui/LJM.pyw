    except ValueError:
        return False


def _safe_archive_member_path(extract_dir, member_name):
    raw_name = normalize_text(member_name)
    if not raw_name or "\x00" in raw_name:
        raise Exception("压缩包包含无效路径，已阻止解压。")
    normalized = raw_name.replace("\\", "/")
    if normalized.startswith("/") or re.match(r"^[A-Za-z]:", normalized):
        raise Exception("压缩包包含绝对路径，已阻止解压。")
    parts = [part for part in normalized.split("/") if part and part != "."]
    if not parts or any(part == ".." for part in parts):
        raise Exception("压缩包包含越界路径，已阻止解压。")
    target_path = os.path.abspath(os.path.join(extract_dir, *parts))
    if not is_within_directory(extract_dir, target_path):
        raise Exception("压缩包包含越界路径，已阻止解压。")
    return target_path


def _zip_member_mode(member):
    return (member.external_attr >> 16) & 0xFFFF


def _zip_member_is_symlink(member):
    return stat.S_IFMT(_zip_member_mode(member)) == stat.S_IFLNK


def _safe_zip_symlink_target(zip_ref, member, link_path, extract_dir):
    try:
        link_target = zip_ref.read(member).decode("utf-8", errors="surrogateescape")
    except Exception as exc:
        raise Exception("压缩包包含无法读取的链接文件，已阻止解压。") from exc
    if not link_target or "\x00" in link_target:
        raise Exception("压缩包包含无效链接文件，已阻止解压。")
    normalized = link_target.replace("\\", "/")
    if normalized.startswith("/") or re.match(r"^[A-Za-z]:", normalized):
        raise Exception("压缩包包含指向绝对路径的链接，已阻止解压。")
    resolved_target = os.path.abspath(os.path.join(os.path.dirname(link_path), link_target))
    if not is_within_directory(extract_dir, resolved_target):
        raise Exception("压缩包包含越界链接，已阻止解压。")
    return link_target


def safe_extract_zip(zip_ref, extract_dir):
    for member in zip_ref.infolist():
        target_path = _safe_archive_member_path(extract_dir, member.filename)
        parent_dir = os.path.dirname(target_path)
        if os.path.lexists(target_path) and not member.is_dir():
            raise Exception("压缩包包含重复文件路径，已阻止解压。")
        os.makedirs(parent_dir, exist_ok=True)
        if not is_within_directory(extract_dir, parent_dir):
            raise Exception("压缩包包含越界路径，已阻止解压。")

        mode = _zip_member_mode(member)
        if _zip_member_is_symlink(member):
            link_target = _safe_zip_symlink_target(zip_ref, member, target_path, extract_dir)
            try:
                os.symlink(link_target, target_path)
            except (AttributeError, NotImplementedError, OSError) as exc:
                raise Exception("当前系统无法安全创建压缩包中的链接文件，已阻止解压。") from exc
            continue

        if member.is_dir():
            os.makedirs(target_path, exist_ok=True)
            if mode:
                try:
                    os.chmod(target_path, mode & 0o777)
                except Exception:
                    pass
            continue

        with zip_ref.open(member, "r") as source, open(target_path, "wb") as dest:
            shutil.copyfileobj(source, dest)
        if mode:
            try:
                os.chmod(target_path, mode & 0o777)
            except Exception:
                pass


def safe_extract_tar(tar_ref, extract_dir):
    for member in tar_ref.getmembers():
        if member.issym() or member.islnk():
            raise Exception("压缩包包含链接文件，已阻止解压。")
        if not (member.isdir() or member.isfile()):
            raise Exception("压缩包包含特殊文件，已阻止解压。")
        target_path = os.path.abspath(os.path.join(extract_dir, member.name))
        if not is_within_directory(extract_dir, target_path):
            raise Exception("压缩包包含越界路径，已阻止解压。")
    tar_ref.extractall(extract_dir)


def is_windows_platform(platform_name=None):
    name = str(platform_name or sys.platform).lower()
    return name.startswith("win")


def ensure_unix_executable(path, platform_name=None):
    if is_windows_platform(platform_name):
        return False
    if not path or not os.path.isfile(path) or os.path.islink(path):
        return False
    try:
        mode = os.stat(path).st_mode & 0o777
        desired = mode | 0o111
        if desired == mode:
            return False
        os.chmod(path, desired)
        return True
    except Exception as exc:
        logging.debug("自动补齐 Unix 可执行权限失败: %s - %s", path, exc)
        return False


def java_unix_executable_candidates(java_home):
    java_home = os.path.abspath(os.path.expanduser(normalize_text(java_home)))
    candidates = []
    for rel_bin in ("bin", os.path.join("jre", "bin")):
        bin_dir = os.path.join(java_home, rel_bin)
        if not os.path.isdir(bin_dir):
            continue
        try:
            names = os.listdir(bin_dir)
        except Exception:
            continue
        for name in names:
            candidate = os.path.join(bin_dir, name)
            if os.path.isfile(candidate) and not os.path.islink(candidate):
                candidates.append(candidate)
    for rel_path in (
        os.path.join("lib", "jspawnhelper"),
        os.path.join("jre", "lib", "jspawnhelper"),
    ):
        candidate = os.path.join(java_home, rel_path)
        if os.path.isfile(candidate) and not os.path.islink(candidate):
            candidates.append(candidate)
    return unique_sequence(candidates)


def ensure_java_home_executables(java_home, platform_name=None):
    if is_windows_platform(platform_name):
        return []
    changed = []
    for candidate in java_unix_executable_candidates(java_home):
        if ensure_unix_executable(candidate, platform_name=platform_name):
            changed.append(candidate)
    if changed:
        logging.info("已自动补齐 Java Unix 可执行权限: %s", ", ".join(changed[:12]))
    return changed


def find_source_jdk_dir(extract_dir):
    exe = "java.exe" if IS_WIN else "java"
    for root_dir, dirs, _files in os.walk(extract_dir):
        if "bin" in dirs and os.path.exists(os.path.join(root_dir, "bin", exe)):
            ensure_java_home_executables(root_dir)
            return root_dir
        candidate_jre = os.path.join(root_dir, "jre", "bin", exe)
        if os.path.exists(candidate_jre):
            ensure_java_home_executables(root_dir)
            return root_dir
    raise FileNotFoundError("download archive does not contain a recognizable Java home")


def validate_java_move_target(source_java_home, target_path):
    source = os.path.abspath(os.path.expanduser(normalize_text(source_java_home)))
    target = os.path.abspath(os.path.expanduser(normalize_text(target_path)))
    if not os.path.isdir(source):
        raise FileNotFoundError(source)
    if os.path.islink(source):
        raise ValueError("source Java home is a symbolic link; unregister it or move the real Java directory")
    if not target:
        raise ValueError("target path is empty")
    if normalize_path(source) == normalize_path(target):
        raise ValueError("target path is the same as source")
    if is_within_directory(source, target):
        raise ValueError("target path cannot be inside source Java home")
    if os.path.exists(target):
        raise FileExistsError(target)
    parent = os.path.dirname(target)
    if not parent:
        raise ValueError("target parent is empty")
    return source, target


def validate_java_delete_target(java_home):
    source = os.path.abspath(os.path.expanduser(normalize_text(java_home)))
    if not os.path.isdir(source):
        raise FileNotFoundError(source)
    if os.path.islink(source):
        raise ValueError("target Java home is a symbolic link; unregister it instead of deleting files")

    dangerous = {
        normalize_path(os.path.expanduser("~")),
        normalize_path(APP_SOURCE_ROOT),
        normalize_path(APP_DIR),
        normalize_path(APP_RESOURCE_DIR),
    }
    drive, _tail = os.path.splitdrive(source)
    if drive:
        dangerous.add(normalize_path(drive + os.sep))
    else:
        dangerous.add(normalize_path(os.sep))
    if normalize_path(source) in {path for path in dangerous if path}:
        raise ValueError("refusing to delete a dangerous top-level directory")

    java_bin = os.path.join(source, "bin", "java.exe" if IS_WIN else "java")
    release_file = os.path.join(source, "release")
    if not os.path.exists(java_bin) and not os.path.exists(release_file):
        raise ValueError("target does not look like a Java home")
    return source


def unregister_java_home(java_home, preferred_name=None):
    names = JavaRegistryAdapter.find_version_names_by_home(java_home)
    if preferred_name:
        names.insert(0, preferred_name)
    removed = []
    for name in unique_sequence(names):
        unregister_java_registry_name(name, java_home=java_home)
        removed.append(name)
    return removed


def unregister_java_registry_name(name, java_home=""):
    try:
        return JavaRegistryAdapter.unregister(name, java_home=java_home)
    except TypeError:
        return JavaRegistryAdapter.unregister(name)


def list_possible_jvm_paths(java_home):
    if IS_WIN:
        dll = "jvm.dll"
        return [
            os.path.join(java_home, "bin", "server", dll),
            os.path.join(java_home, "bin", "client", dll),
            os.path.join(java_home, "lib", "server", dll),
            os.path.join(java_home, "bin", "default", dll),
            os.path.join(java_home, "bin", "compressedrefs", dll),
            os.path.join(java_home, "jre", "bin", "server", dll),
            os.path.join(java_home, "jre", "bin", "default", dll),
            os.path.join(java_home, "jre", "bin", "compressedrefs", dll),
        ]
    dll = "libjvm.dylib" if sys.platform == "darwin" else "libjvm.so"
    return [
        os.path.join(java_home, "lib", "server", dll),
        os.path.join(java_home, "lib", "client", dll),
        os.path.join(java_home, "lib", "default", dll),
        os.path.join(java_home, "jre", "lib", "server", dll),
        os.path.join(java_home, "jre", "lib", "default", dll),
    ]


def find_jvm_library(java_home):
    for candidate in list_possible_jvm_paths(java_home):
        if os.path.exists(candidate):
            return candidate
    return ""


def find_java_binary(java_home):
    exe = "java.exe" if IS_WIN else "java"
    candidates = [
        os.path.join(java_home, "bin", exe),
        os.path.join(java_home, "jre", "bin", exe),
    ]
    for candidate in candidates:
        if os.path.exists(candidate):
            return candidate
    return ""


def find_javaw_binary(java_home):
    exe = "javaw.exe" if IS_WIN else "java"
    candidates = [
        os.path.join(java_home, "bin", exe),
        os.path.join(java_home, "jre", "bin", exe),
