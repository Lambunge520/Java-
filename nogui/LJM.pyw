        os_type = platform_os()
        arch = ARCH_INFO["adoptium"]
        package_type = normalize_java_package_type(package_type)
        query = f"os={os_type}&architecture={arch}&image_type={package_type}"
        urls = []
        for endpoint in ADOPTIUM_API_ENDPOINTS:
            if endpoint == "latest":
                urls.append((endpoint, f"https://api.adoptium.net/v3/assets/latest/{major_version}/{jvm_impl}?{query}"))
            elif endpoint == "feature_releases":
                urls.append((endpoint, f"https://api.adoptium.net/v3/assets/feature_releases/{major_version}/ga?{query}&jvm_impl={jvm_impl}&heap_size=normal"))
