    def _tool_update_endpoints(self):
        endpoints = []
        source = APP_CONFIG.get("update_source", "official")
        if source == "mirror":
            endpoints.extend(build_github_url_variants(API_TOOL_UPDATE))
        elif source == "github":
            endpoints.extend(unique_sequence([API_TOOL_UPDATE] + build_github_url_variants(API_TOOL_UPDATE, include_direct=False)))
        else:
            endpoints.extend(build_github_url_variants(API_TOOL_UPDATE))
        return unique_sequence(endpoints)

    def _tool_direct_asset_exts(self):
        exts = []
        if APP_EXT:
            exts.append(APP_EXT)
        if IS_WIN:
            exts.append(".exe")
        if not getattr(sys, "frozen", False):
            exts.extend([".pyw", ".py"])
        return unique_sequence(exts)

    def _tool_archive_asset_exts(self):
        return (".zip", ".tar.gz", ".tgz")

    def _tool_asset_has_suffix(self, name, suffix):
        lower = normalize_text(name).lower()
        return lower.endswith(suffix)

    def _tool_asset_platform_score(self, name):
        lower = normalize_text(name).lower()
        score = 0
        if IS_WIN:
            current_os = ("windows", "win64", "win32")
            foreign_os = ("linux", "macos", "darwin", "osx")
        elif sys.platform == "darwin":
            current_os = ("macos", "darwin", "osx", "mac")
            foreign_os = ("windows", "win64", "win32", "linux")
        else:
            current_os = ("linux", "ubuntu", "debian", "appimage")
            foreign_os = ("windows", "win64", "win32", "macos", "darwin", "osx")

        has_current_os = any(token in lower for token in current_os)
        has_foreign_os = any(token in lower for token in foreign_os)
        if has_foreign_os and not has_current_os:
            return -1000
        if has_current_os:
            score += 20

        if APP_ARCH in ("amd64", "x86_64", "x64"):
            current_arch = ("x64", "amd64", "x86_64")
            foreign_arch = ("arm64", "aarch64", "win32", "i386", "i686")
        elif APP_ARCH in ("arm64", "aarch64"):
            current_arch = ("arm64", "aarch64")
            foreign_arch = ("x64", "amd64", "x86_64", "win32", "i386", "i686")
        else:
            current_arch = ("win32", "i386", "i686", "x86")
            foreign_arch = ("x64", "amd64", "x86_64", "arm64", "aarch64")

        has_current_arch = any(token in lower for token in current_arch)
        has_foreign_arch = any(token in lower for token in foreign_arch)
        if has_foreign_arch and not has_current_arch:
            return -1000
        if has_current_arch:
            score += 10

        current_stem = os.path.splitext(os.path.basename(APP_EXECUTABLE_PATH))[0].lower()
        asset_stem = os.path.splitext(os.path.basename(lower))[0].lower()
        if asset_stem == current_stem:
            score += 12
        elif current_stem and current_stem in asset_stem:
            score += 6
        if "ljm" in lower or "java" in lower:
            score += 2
        return score

    def _pick_tool_asset_url(self, assets):
        def ranked_assets(exts):
            ranked = []
            for asset in assets:
                name = normalize_text(asset.get("name"))
                if not name:
                    continue
                lower = name.lower()
                if not any(self._tool_asset_has_suffix(lower, ext) for ext in exts):
                    continue
                score = self._tool_asset_platform_score(lower)
                if score < 0:
                    continue
                ranked.append((score, name, asset))
            ranked.sort(key=lambda item: (item[0], item[1]), reverse=True)
            return ranked

        for _score, _name, asset in ranked_assets(self._tool_direct_asset_exts()):
            url = asset.get("browser_download_url")
            if url:
                return url

        for _score, _name, asset in ranked_assets(self._tool_archive_asset_exts()):
            url = asset.get("browser_download_url")
            if url:
                return url
        return None

    def _detect_tool_update_package_type(self, path, source_url):
        lower = normalize_text(source_url).lower()
        parsed_path = urlparse(lower).path
        if parsed_path.endswith((".tar.gz", ".tgz")):
            return "tar"
        if parsed_path.endswith(".zip"):
            return "zip"
        try:
            if zipfile.is_zipfile(path):
                return "zip"
        except Exception:
            pass
        try:
            if tarfile.is_tarfile(path):
                return "tar"
        except Exception:
            pass
        return ""

    def _self_update_payload_exts(self):
        if getattr(sys, "frozen", False):
            return [APP_EXT] if APP_EXT else [""]
        exts = []
        if APP_EXT:
            exts.append(APP_EXT)
        exts.extend([".pyw", ".py"])
        return unique_sequence(exts)

    def _score_self_update_payload(self, path, extract_dir):
        if not os.path.isfile(path) or os.path.getsize(path) <= 0:
            return None
        rel_path = os.path.relpath(path, extract_dir)
        rel_lower = rel_path.replace("\\", "/").lower()
        if "__macosx/" in rel_lower or rel_lower.startswith("__macosx/"):
            return None

        name = os.path.basename(path).lower()
        stem, ext = os.path.splitext(name)
        allowed_exts = self._self_update_payload_exts()
        if ext not in allowed_exts and not ("" in allowed_exts and "." not in name):
            return None

        platform_score = self._tool_asset_platform_score(rel_lower)
        if platform_score < 0:
            return None

        current_name = os.path.basename(APP_EXECUTABLE_PATH).lower()
        current_stem = os.path.splitext(current_name)[0]
        has_name_hint = (
            name == current_name
            or stem == current_stem
            or (current_stem and current_stem in stem)
            or "ljm" in stem
            or ("java" in stem and "manager" in rel_lower)
        )
        if not has_name_hint:
            return None

        score = platform_score
        if name == current_name:
            score += 60
        elif stem == current_stem:
            score += 45
        elif current_stem and current_stem in stem:
            score += 20
        if APP_EXT and ext == APP_EXT:
            score += 18
        if "ljm" in stem or ("java" in stem and "manager" in rel_lower):
            score += 8
        score -= rel_lower.count("/")
        return score

    def _find_self_update_payload(self, extract_dir):
        candidates = []
        for root_dir, _dirs, files in os.walk(extract_dir):
            for filename in files:
                path = os.path.join(root_dir, filename)
                score = self._score_self_update_payload(path, extract_dir)
                if score is not None:
                    candidates.append((score, path))
        if not candidates:
            raise Exception(tr("self_update_no_payload"))
        candidates.sort(key=lambda item: item[0], reverse=True)
        return candidates[0][1]

    def _self_update_target_dir(self):
        if sys.platform == "darwin":
            current = APP_EXECUTABLE_PATH
            while current and current != os.path.dirname(current):
                if current.lower().endswith(".app"):
                    return current
                current = os.path.dirname(current)
        return APP_DIR

    def _self_update_bundle_dir(self, payload_path, extract_dir):
        if sys.platform == "darwin":
            current = payload_path
            while current and is_within_directory(extract_dir, current):
                if current.lower().endswith(".app"):
                    return current
                parent = os.path.dirname(current)
                if parent == current:
                    break
                current = parent
        return os.path.dirname(payload_path)

    def _stage_self_update_payload(self, downloaded_path, source_url, staged_path, status_cb):
        package_type = self._detect_tool_update_package_type(downloaded_path, source_url)
        if not package_type:
            shutil.move(downloaded_path, staged_path)
            return "", ""

        status_cb(tr("self_update_extracting"))
        extract_dir = tempfile.mkdtemp(prefix="ljm_tool_update_extract_")
        try:
            if package_type == "tar":
                with tarfile.open(downloaded_path, "r:*") as tar_ref:
                    safe_extract_tar(tar_ref, extract_dir)
            else:
                with zipfile.ZipFile(downloaded_path, "r") as zip_ref:
                    safe_extract_zip(zip_ref, extract_dir)

            payload_path = self._find_self_update_payload(extract_dir)
            if os.path.exists(staged_path):
                os.remove(staged_path)
            shutil.copy2(payload_path, staged_path)
            if not IS_WIN:
                try:
                    os.chmod(staged_path, os.stat(staged_path).st_mode | 0o755)
                except Exception:
                    pass
            return self._self_update_bundle_dir(payload_path, extract_dir), extract_dir
        except Exception:
            shutil.rmtree(extract_dir, ignore_errors=True)
            raise

    def check_tool_update(self):
        def task():
            try:
                data = None
                for endpoint in self._tool_update_endpoints():
                    try:
                        data = NetworkEngine.request_json(endpoint, timeout=8, retries=2, cache_ttl=180)
                        if data:
                            break
                    except Exception as exc:
                        logging.warning("工具更新接口失败: %s - %s", endpoint, exc)
                if not data:
                    raise Exception("未能获取工具更新信息。")

                latest_ver = normalize_text(data.get("tag_name"))
                if latest_ver and parse_app_version(latest_ver) > parse_app_version(VERSION):
                    asset_url = self._pick_tool_asset_url(data.get("assets", []))
                    if asset_url:
                        self.root.after(0, lambda: self.prompt_tool_update(latest_ver, asset_url))
                    else:
                        self.root.after(0, lambda: messagebox.showinfo(tr("tool_update_hint_title"), tr("tool_update_no_asset", version=latest_ver)))
                else:
                    self.root.after(0, lambda: messagebox.showinfo(tr("tool_update_check_title"), tr("tool_update_latest")))
            except Exception as exc:
                logging.error("检查工具更新失败: %s", exc)
                self.root.after(0, lambda: messagebox.showerror(tr("tool_update_error_title"), tr("tool_update_error")))

        threading.Thread(target=task, daemon=True).start()

    def prompt_tool_update(self, new_ver, url):
        if messagebox.askyesno(tr("tool_update_prompt_title"), tr("tool_update_prompt", version=new_ver)):
            self.execute_self_update(url)

    def execute_self_update(self, url):
        return self.execute_self_update_popup(url)

    def _windows_self_update_script(self, temp_new, bundle_dir, cleanup_dir, target_dir, launch_command):
        app_name = os.path.basename(APP_EXECUTABLE_PATH)
        lines = [
            "@echo off",
            "setlocal EnableExtensions EnableDelayedExpansion",
            "timeout /t 1 /nobreak >nul",
        ]
        if bundle_dir:
            lines.extend([
                f'robocopy "{bundle_dir}" "{target_dir}" /E /NFL /NDL /NJH /NJS /NP /XF "{app_name}" >nul',
                "if errorlevel 8 exit /b 1",
            ])
        lines.extend([
            "set /a LJM_REPLACE_RETRY=0",
            ":replace_self_update",
            f'move /y "{temp_new}" "{APP_EXECUTABLE_PATH}" >nul',
            "if errorlevel 1 (",
            "  set /a LJM_REPLACE_RETRY+=1",
            "  if !LJM_REPLACE_RETRY! GEQ 20 exit /b 1",
            "  timeout /t 1 /nobreak >nul",
            "  goto replace_self_update",
            ")",
        ])
        if cleanup_dir:
            lines.append(f'rmdir /s /q "{cleanup_dir}"')
        lines.extend([
            f"start \"\" {launch_command}",
            'del "%~f0"',
        ])
        return "\n".join(lines) + "\n"

    def _unix_self_update_script(self, temp_new, bundle_dir, cleanup_dir, target_dir, launch_command):
        q_temp_new = shlex.quote(temp_new)
        q_app_path = shlex.quote(APP_EXECUTABLE_PATH)
        q_target_dir = shlex.quote(target_dir)
        lines = [
            "#!/bin/sh",
            "set -e",
            "sleep 1",
        ]
        if bundle_dir:
            main_rel = os.path.relpath(APP_EXECUTABLE_PATH, target_dir).replace("\\", "/")
            if main_rel == ".." or main_rel.startswith("../"):
                main_rel = os.path.basename(APP_EXECUTABLE_PATH)
            main_rel = "./" + main_rel.lstrip("./")
            main_rel_quoted = main_rel.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`")
            lines.extend([
                f"LJM_BUNDLE_DIR={shlex.quote(bundle_dir)}",
                f"LJM_TARGET_DIR={q_target_dir}",
                f'LJM_MAIN_REL="{main_rel_quoted}"',
                '(cd "$LJM_BUNDLE_DIR" && find . -mindepth 1 -print) | while IFS= read -r item; do',
                '  if [ "$item" = "$LJM_MAIN_REL" ]; then continue; fi',
                '  src="$LJM_BUNDLE_DIR/${item#./}"',
                '  dst="$LJM_TARGET_DIR/${item#./}"',
                '  if [ -L "$src" ]; then',
                '    mkdir -p "$(dirname "$dst")"',
                '    rm -rf "$dst"',
                '    cp -P "$src" "$dst"',
                '  elif [ -d "$src" ]; then',
                '    mkdir -p "$dst"',
                '  else',
                '    mkdir -p "$(dirname "$dst")"',
                '    cp -p "$src" "$dst"',
                '  fi',
                "done",
            ])
        lines.extend([
            "LJM_REPLACE_RETRY=0",
            "while ! mv -f " + q_temp_new + " " + q_app_path + "; do",
            "  LJM_REPLACE_RETRY=$((LJM_REPLACE_RETRY + 1))",
            "  [ \"$LJM_REPLACE_RETRY\" -ge 20 ] && exit 1",
            "  sleep 1",
            "done",
            f"chmod +x {q_app_path}",
        ])
        if cleanup_dir:
            lines.append(f"rm -rf {shlex.quote(cleanup_dir)}")
        lines.extend([
            f"{launch_command} &",
            'rm "$0"',
        ])
        return "\n".join(lines) + "\n"

    def execute_self_update_popup(self, url):
        top = tk.Toplevel(self.root)
        self._configure_popup(top, tr("self_update_title"), 460, 170, min_w=380, min_h=150, max_w_ratio=0.7, max_h_ratio=0.35, resizable=False)

        progress = ttk.Progressbar(top, orient=tk.HORIZONTAL, mode="determinate")
        progress.pack(fill=tk.X, padx=20, pady=(20, 12))
        status_label = tk.Label(top, text=tr("self_update_status"), justify="center", wraplength=400)
        status_label.pack(fill=tk.X, padx=16)
        self._traverse_and_paint(top)

        def update_progress(percent, downloaded, total):
            progress.config(value=percent)
            if total > 0:
                status_label.config(text=f"下载中: {downloaded / 1024 / 1024:.1f} MB / {total / 1024 / 1024:.1f} MB")
            else:
                status_label.config(text=f"下载中: {downloaded / 1024 / 1024:.1f} MB")

        def update_status(message):
            self.root.after(0, lambda: status_label.config(text=message))

        def dl_task():
            temp_download = os.path.join(tempfile.gettempdir(), f"ljm_tool_update_{os.getpid()}_{int(time.time())}.download")
            temp_new = APP_EXECUTABLE_PATH + ".new"
            bundle_dir = ""
            cleanup_dir = ""
            try:
                if os.path.exists(temp_new):
                    os.remove(temp_new)
                update_urls = build_github_url_variants(url) if is_github_like_url(url) else [url]
                used_url = NetworkEngine.download_from_candidates(update_urls, temp_download, lambda *args: self.root.after(0, lambda: update_progress(*args)), update_status)
                bundle_dir, cleanup_dir = self._stage_self_update_payload(temp_download, used_url or url, temp_new, update_status)
                try:
                    if os.path.exists(temp_download):
                        os.remove(temp_download)
                except Exception:
                    pass
                target_dir = self._self_update_target_dir()
                launch_command = app_launch_command()
                if IS_WIN:
                    bat_path = os.path.join(tempfile.gettempdir(), "update_java_mgr.bat")
                    with open(bat_path, "w", encoding="gbk") as f:
                        f.write(self._windows_self_update_script(temp_new, bundle_dir, cleanup_dir, target_dir, launch_command))
                    os.startfile(bat_path)
                else:
                    sh_path = os.path.join(tempfile.gettempdir(), "update_java_mgr.sh")
                    with open(sh_path, "w", encoding="utf-8") as f:
                        f.write(self._unix_self_update_script(temp_new, bundle_dir, cleanup_dir, target_dir, launch_command))
                    os.system(f'chmod +x "{sh_path}" && "{sh_path}" &')
                self.root.after(0, sys.exit)
            except Exception as exc:
                try:
                    if os.path.exists(temp_download):
                        os.remove(temp_download)
                except Exception:
                    pass
                if cleanup_dir:
                    shutil.rmtree(cleanup_dir, ignore_errors=True)
                self.root.after(0, top.destroy)
                self.root.after(0, lambda: messagebox.showerror(tr("self_update_failed_title"), str(exc)))

        threading.Thread(target=dl_task, daemon=True).start()

