    def _mirror_speed_summary_text(self):
        results = APP_CONFIG.get("mirror_speed_results", {}) or {}
        if not results:
            return tr("mirror_speed_none")
        parts = []
        for prefix in ranked_github_mirror_prefixes():
            delay = results.get(prefix)
