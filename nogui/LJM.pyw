    def _traverse_and_paint(self, widget):
        try:
            widget_class = widget.winfo_class()
            if widget_class in ("Frame", "Toplevel", "Labelframe"):
                widget.configure(bg=self.current_bg)
            elif widget_class == "Label":
                widget.configure(bg=self.current_bg, fg=self.current_fg)
            elif widget_class in ("Radiobutton", "Checkbutton"):
                widget.configure(
                    bg=self.current_bg,
                    fg=self.current_fg,
                    activebackground=self.current_bg,
                    activeforeground=self.current_fg,
                    selectcolor=self.current_bg,
                )
            elif widget_class == "Button":
                widget.configure(
                    bg=self.current_btn,
                    fg=self.current_fg,
                    activebackground=self.current_bg,
                    activeforeground=self.current_fg,
                    relief="flat",
                    bd=1,
                )
            elif widget_class == "Listbox":
                widget.configure(
                    bg=self.current_field,
                    fg=self.current_fg,
                    selectbackground=self.current_btn,
                    bd=1,
                    highlightthickness=0,
                )
            elif widget_class == "Entry":
                widget.configure(
                    bg=self.current_field,
                    fg=self.current_fg,
                    insertbackground=self.current_fg,
                    relief="flat",
                    bd=2,
                )
            elif widget_class == "Text":
                widget.configure(
                    bg=self.current_field,
                    fg=self.current_fg,
                    insertbackground=self.current_fg,
                    selectbackground=self.current_btn,
                    selectforeground=self.current_fg,
                    relief="flat",
                    bd=2,
                    highlightthickness=0,
                )
        except Exception:
            pass
        for child in widget.winfo_children():
            self._traverse_and_paint(child)

    def _window_fade_key(self, window):
        return str(window)

    def _cancel_window_fade(self, window):
        job = getattr(self, "_window_fade_jobs", {}).pop(self._window_fade_key(window), None)
        if not job:
            return
        try:
            window.after_cancel(job)
        except Exception:
            pass

    def _remember_window_fade_job(self, window, job):
        if job:
            self._window_fade_jobs[self._window_fade_key(window)] = job

    def _clear_window_fade_job(self, window):
        getattr(self, "_window_fade_jobs", {}).pop(self._window_fade_key(window), None)

    def _set_window_alpha(self, window, alpha):
        try:
            window.attributes("-alpha", max(0.0, min(float(alpha), 1.0)))
            return True
        except Exception:
            return False

    def _fade_in_window(self, window, duration=320, steps=12, start_alpha=0.0):
        self._cancel_window_fade(window)
        try:
            if not window.winfo_exists():
                return
        except Exception:
            return
        start_alpha = max(0.0, min(float(start_alpha), 0.98))
        if not self._set_window_alpha(window, start_alpha):
            return

        interval = max(10, int(duration / max(1, steps)))

        def tick(index=1):
            try:
                if not window.winfo_exists():
                    return
                alpha = start_alpha + ((1.0 - start_alpha) * index / max(1, steps))
                self._set_window_alpha(window, alpha)
                if index < steps:
                    job = window.after(interval, lambda: tick(index + 1))
                    self._remember_window_fade_job(window, job)
                else:
                    self._set_window_alpha(window, 1.0)
                    self._clear_window_fade_job(window)
            except Exception:
                self._clear_window_fade_job(window)
                pass

        self._remember_window_fade_job(window, window.after(interval, tick))

    def _fade_out_window(self, window, on_done=None, duration=220, steps=10):
        self._cancel_window_fade(window)
        try:
            if not window.winfo_exists():
                return
        except Exception:
            return
        interval = max(10, int(duration / max(1, steps)))

        def finish():
            self._clear_window_fade_job(window)
            try:
                if on_done:
                    on_done()
            except Exception:
                pass

        def tick(index=steps):
            try:
                if not window.winfo_exists():
                    return
                alpha = max(0.0, index / max(1, steps))
                if not self._set_window_alpha(window, alpha):
                    finish()
                    return
                if index > 1:
                    job = window.after(interval, lambda: tick(index - 1))
                    self._remember_window_fade_job(window, job)
                else:
                    finish()
            except Exception:
                finish()

        tick()

    def _install_fade_destroy(self, window):
        if getattr(window, "_ljm_fade_destroy_installed", False):
            return
        original_destroy = window.destroy
        state = {"closing": False}

        def fade_destroy():
            if state["closing"]:
                try:
                    original_destroy()
                except Exception:
                    pass
                return
            state["closing"] = True
            self._fade_out_window(window, on_done=original_destroy)

        try:
            window._ljm_fade_destroy_installed = True
            window.destroy = fade_destroy
            window.protocol("WM_DELETE_WINDOW", fade_destroy)
        except Exception:
            pass

    def _tk_screen_metrics(self, widget=None):
        widget = widget or self.root
        try:
            widget.update_idletasks()
        except Exception:
            pass

        screen_width = max(int(widget.winfo_screenwidth()), 1)
        screen_height = max(int(widget.winfo_screenheight()), 1)
        virtual_width = max(int(widget.winfo_vrootwidth()), screen_width)
        virtual_height = max(int(widget.winfo_vrootheight()), screen_height)
        virtual_x = int(widget.winfo_vrootx())
        virtual_y = int(widget.winfo_vrooty())
        try:
            scaling = float(widget.tk.call("tk", "scaling"))
        except Exception:
            scaling = 1.3333333333
        scale_percent = max(100, int(round(scaling * 75)))
        return {
            "screen_width": screen_width,
            "screen_height": screen_height,
            "virtual_width": virtual_width,
            "virtual_height": virtual_height,
            "virtual_x": virtual_x,
            "virtual_y": virtual_y,
            "work_width": virtual_width,
            "work_height": virtual_height,
            "scaling": scaling,
            "scale_percent": scale_percent,
            "source": "tk",
        }

    def _windows_display_metrics(self, widget=None, fallback=None):
        fallback = fallback or self._tk_screen_metrics(widget)
        if not IS_WIN:
            return fallback

        class MONITORINFOEXW(ctypes.Structure):
            _fields_ = [
                ("cbSize", wintypes.DWORD),
                ("rcMonitor", wintypes.RECT),
                ("rcWork", wintypes.RECT),
                ("dwFlags", wintypes.DWORD),
                ("szDevice", wintypes.WCHAR * 32),
            ]

        class DEVMODEW(ctypes.Structure):
            _fields_ = [
                ("dmDeviceName", wintypes.WCHAR * 32),
                ("dmSpecVersion", wintypes.WORD),
                ("dmDriverVersion", wintypes.WORD),
                ("dmSize", wintypes.WORD),
                ("dmDriverExtra", wintypes.WORD),
                ("dmFields", wintypes.DWORD),
                ("dmOrientation", wintypes.SHORT),
                ("dmPaperSize", wintypes.SHORT),
                ("dmPaperLength", wintypes.SHORT),
                ("dmPaperWidth", wintypes.SHORT),
                ("dmScale", wintypes.SHORT),
                ("dmCopies", wintypes.SHORT),
                ("dmDefaultSource", wintypes.SHORT),
                ("dmPrintQuality", wintypes.SHORT),
                ("dmColor", wintypes.SHORT),
                ("dmDuplex", wintypes.SHORT),
                ("dmYResolution", wintypes.SHORT),
                ("dmTTOption", wintypes.SHORT),
                ("dmCollate", wintypes.SHORT),
                ("dmFormName", wintypes.WCHAR * 32),
                ("dmLogPixels", wintypes.WORD),
                ("dmBitsPerPel", wintypes.DWORD),
                ("dmPelsWidth", wintypes.DWORD),
                ("dmPelsHeight", wintypes.DWORD),
                ("dmDisplayFlags", wintypes.DWORD),
                ("dmDisplayFrequency", wintypes.DWORD),
            ]

        metrics = dict(fallback)
        try:
            user32 = ctypes.windll.user32
            hwnd = widget.winfo_id() if widget is not None else self.root.winfo_id()
            monitor = user32.MonitorFromWindow(wintypes.HWND(hwnd), 2)
            info = MONITORINFOEXW()
            info.cbSize = ctypes.sizeof(MONITORINFOEXW)

            if monitor and user32.GetMonitorInfoW(monitor, ctypes.byref(info)):
                monitor_width = max(info.rcMonitor.right - info.rcMonitor.left, 1)
                monitor_height = max(info.rcMonitor.bottom - info.rcMonitor.top, 1)
                work_width = max(info.rcWork.right - info.rcWork.left, 1)
                work_height = max(info.rcWork.bottom - info.rcWork.top, 1)
                screen_width = monitor_width
                screen_height = monitor_height

                dev_mode = DEVMODEW()
                dev_mode.dmSize = ctypes.sizeof(DEVMODEW)
                if user32.EnumDisplaySettingsW(info.szDevice, -1, ctypes.byref(dev_mode)):
                    if dev_mode.dmPelsWidth and dev_mode.dmPelsHeight:
                        screen_width = int(dev_mode.dmPelsWidth)
                        screen_height = int(dev_mode.dmPelsHeight)

                scale_percent = metrics.get("scale_percent", 100)
                try:
                    dpi_x = wintypes.UINT()
                    dpi_y = wintypes.UINT()
                    if ctypes.windll.shcore.GetDpiForMonitor(monitor, 0, ctypes.byref(dpi_x), ctypes.byref(dpi_y)) == 0:
                        scale_percent = max(100, int(round(int(dpi_x.value) * 100 / 96)))
                except Exception:
                    try:
                        scale_percent = int(ctypes.windll.shcore.GetScaleFactorForMonitor(monitor))
                    except Exception:
                        try:
                            dpi = int(user32.GetDpiForSystem())
                            scale_percent = max(100, int(round(dpi * 100 / 96)))
                        except Exception:
                            pass

                logical_width = max(int(fallback.get("screen_width") or fallback.get("virtual_width") or 0), 1)
                logical_height = max(int(fallback.get("screen_height") or fallback.get("virtual_height") or 0), 1)
                ratio_scale = int(round(max(screen_width / logical_width, screen_height / logical_height) * 100))
                if ratio_scale >= 100 and abs(ratio_scale - scale_percent) > 5:
                    scale_percent = ratio_scale
                logical_scale = max(scale_percent, 100) / 100
                work_is_physical = work_width > logical_width * 1.05 or work_height > logical_height * 1.05
                if work_is_physical:
                    work_logical_x = int(round(info.rcWork.left / logical_scale))
                    work_logical_y = int(round(info.rcWork.top / logical_scale))
                    work_logical_width = max(int(round(work_width / logical_scale)), 1)
                    work_logical_height = max(int(round(work_height / logical_scale)), 1)
                else:
                    work_logical_x = int(info.rcWork.left)
                    work_logical_y = int(info.rcWork.top)
                    work_logical_width = work_width
                    work_logical_height = work_height

                metrics.update(
                    {
                        "screen_width": screen_width,
                        "screen_height": screen_height,
                        "work_width": work_width,
                        "work_height": work_height,
                        "virtual_width": work_logical_width,
                        "virtual_height": work_logical_height,
                        "virtual_x": work_logical_x,
                        "virtual_y": work_logical_y,
                        "scale_percent": scale_percent,
                        "scaling": scale_percent / 75,
                        "display_name": info.szDevice,
                        "source": "windows",
                    }
                )
        except Exception as exc:
            logging.debug("读取 Windows 显示环境失败: %s", exc)
        return metrics

    def _screen_metrics(self, widget=None):
        fallback = self._tk_screen_metrics(widget)
        return self._windows_display_metrics(widget, fallback)

    def _screen_summary_text(self):
        metrics = self._screen_metrics()
        return (
            f"屏幕分辨率: {metrics['screen_width']} x {metrics['screen_height']}    "
            f"工作区: {metrics['virtual_width']} x {metrics['virtual_height']}    "
            f"系统缩放: {metrics['scale_percent']}%"
        )

    def _screen_summary_text(self):
        metrics = self._screen_metrics()
        return (
            f"系统分辨率: {metrics['screen_width']} x {metrics['screen_height']}    "
            f"系统缩放: {metrics['scale_percent']}%    "
            f"窗口可用区: {metrics['virtual_width']} x {metrics['virtual_height']}"
        )

    def _screen_summary_text(self):
        metrics = self._screen_metrics()
        return tr(
            "screen_summary",
            width=metrics["screen_width"],
            height=metrics["screen_height"],
            scale=metrics["scale_percent"],
            work_width=metrics["virtual_width"],
            work_height=metrics["virtual_height"],
        )

    def _set_window_geometry(self, window, width, height, min_w=320, min_h=240, max_w_ratio=0.92, max_h_ratio=0.9):
        metrics = self._screen_metrics(window)
        max_width = max(min_w, int(metrics["virtual_width"] * max_w_ratio))
        max_height = max(min_h, int(metrics["virtual_height"] * max_h_ratio))
        target_width = min(max(width, min_w), max_width)
        target_height = min(max(height, min_h), max_height)
        usable_min_w = min(min_w, target_width)
        usable_min_h = min(min_h, target_height)
        window.minsize(usable_min_w, usable_min_h)
        x = metrics["virtual_x"] + max((metrics["virtual_width"] - target_width) // 2, 0)
        y = metrics["virtual_y"] + max((metrics["virtual_height"] - target_height) // 2, 0)
        window.geometry(f"{target_width}x{target_height}+{x}+{y}")
        return target_width, target_height

    def _init_main_window(self):
        metrics = self._screen_metrics(self.root)
        target_width = max(960, int(metrics["virtual_width"] * 0.78))
        target_height = max(640, int(metrics["virtual_height"] * 0.74))
        max_width = max(960, metrics["virtual_width"] - 40)
        max_height = max(640, metrics["virtual_height"] - 60)
        target_width = min(target_width, max_width)
        target_height = min(target_height, max_height)
        min_width = min(1120, target_width)
        min_height = min(680, target_height)
        self._set_window_geometry(
            self.root,
            target_width,
            target_height,
            min_w=min_width,
            min_h=min_height,
            max_w_ratio=0.96,
            max_h_ratio=0.92,
        )

    def _configure_popup(self, window, title, width, height, min_w=320, min_h=240, max_w_ratio=0.88, max_h_ratio=0.88, resizable=True, transient=True):
        window.title(title)
        window.resizable(resizable, resizable)
        if self.icon_img:
            window.iconphoto(True, self.icon_img)
        window.configure(bg=self.current_bg)
        if transient:
            try:
                window.transient(self.root)
            except Exception:
                pass
        self._set_window_geometry(window, width, height, min_w=min_w, min_h=min_h, max_w_ratio=max_w_ratio, max_h_ratio=max_h_ratio)
        self._install_fade_destroy(window)
        self._fade_in_window(window)
        return window

    def _install_mousewheel_scroll(self, scope_widget, canvas):
        drag_state = {"active": False, "x": 0, "y": 0}

        def event_xy_on_canvas(event):
            return (
                int(getattr(event, "x_root", 0) - canvas.winfo_rootx()),
                int(getattr(event, "y_root", 0) - canvas.winfo_rooty()),
            )

        def on_mousewheel(event):
            step = scroll_units_from_wheel_event(getattr(event, "delta", 0), getattr(event, "num", None))
            if not step:
                return
            target = getattr(event, "widget", None)
            target_class = ""
            try:
                target_class = target.winfo_class()
            except Exception:
                target_class = ""
            horizontal = is_horizontal_scroll_state(getattr(event, "state", 0))
            if target_class in ("Treeview", "Listbox") and hasattr(target, "xview") and horizontal:
                target.xview_scroll(step, "units")
            elif target_class in ("Treeview", "Listbox") and hasattr(target, "yview"):
                target.yview_scroll(step, "units")
            elif horizontal:
                canvas.xview_scroll(step, "units")
            else:
                canvas.yview_scroll(step, "units")
            return "break"

        def on_touch_start(event):
            try:
                if not widget_class_allows_touch_scroll(event.widget.winfo_class()):
                    drag_state["active"] = False
                    return
                x, y = event_xy_on_canvas(event)
                drag_state.update({"active": True, "x": x, "y": y})
                canvas.scan_mark(x, y)
            except Exception:
                drag_state["active"] = False

        def on_touch_drag(event):
            if not drag_state["active"]:
                return
            try:
                x, y = event_xy_on_canvas(event)
                if abs(x - drag_state["x"]) < 2 and abs(y - drag_state["y"]) < 2:
                    return
                canvas.scan_dragto(x, y, gain=1)
                return "break"
            except Exception:
                return

        def on_touch_end(_event=None):
            drag_state["active"] = False

        def bind_recursive(widget):
            for sequence in ("<MouseWheel>", "<Shift-MouseWheel>", "<Button-4>", "<Button-5>", "<Shift-Button-4>", "<Shift-Button-5>"):
                widget.bind(sequence, on_mousewheel, add="+")
            if widget_class_allows_touch_scroll(widget.winfo_class()):
                widget.bind("<ButtonPress-1>", on_touch_start, add="+")
                widget.bind("<B1-Motion>", on_touch_drag, add="+")
                widget.bind("<ButtonRelease-1>", on_touch_end, add="+")
                widget.bind("<Leave>", on_touch_end, add="+")
            for child in widget.winfo_children():
                bind_recursive(child)

        bind_recursive(scope_widget)

    def _create_scrollable_area(self, parent, fill_width=True, fill_height=True):
        shell = tk.Frame(parent, bg=self.current_bg)
        shell.pack(fill=tk.BOTH, expand=True)
        shell.grid_rowconfigure(0, weight=1)
        shell.grid_columnconfigure(0, weight=1)

        canvas = tk.Canvas(shell, bg=self.current_bg, highlightthickness=0, bd=0)
        y_scroll = ttk.Scrollbar(shell, orient=tk.VERTICAL, command=canvas.yview)
        x_scroll = ttk.Scrollbar(shell, orient=tk.HORIZONTAL, command=canvas.xview)
        canvas.configure(yscrollcommand=y_scroll.set, xscrollcommand=x_scroll.set)
        canvas.grid(row=0, column=0, sticky="nsew")
        y_scroll.grid(row=0, column=1, sticky="ns")
        x_scroll.grid(row=1, column=0, sticky="ew")

        content = tk.Frame(canvas, bg=self.current_bg)
        window_id = canvas.create_window((0, 0), window=content, anchor="nw")

        def sync_scroll_region(_event=None):
            try:
                width = canvas.winfo_width()
                height = canvas.winfo_height()
                req_width = content.winfo_reqwidth()
                req_height = content.winfo_reqheight()
                canvas.itemconfigure(window_id, width=max(width, req_width) if fill_width else req_width)
                if fill_height:
                    canvas.itemconfigure(window_id, height=max(height, req_height))
                bbox = canvas.bbox("all")
                if bbox:
                    canvas.configure(scrollregion=bbox)
            except Exception:
                pass

        content.bind("<Configure>", sync_scroll_region)
        canvas.bind("<Configure>", sync_scroll_region)
        parent.after(0, sync_scroll_region)
        return content, canvas

    def _cancel_tab_motion_jobs(self):
        for canvas, job in list(getattr(self, "_tab_motion_jobs", {}).items()):
            try:
                canvas.after_cancel(job)
            except Exception:
                pass
        self._tab_motion_jobs.clear()

    def _create_tab_motion_header(self, tab_widget, parent, title_key):
        canvas = tk.Canvas(parent, height=40, bd=0, highlightthickness=0, bg=self.current_bg)
        canvas.pack(fill=tk.X, padx=10, pady=(10, 2))
        canvas._ljm_title_key = title_key
        canvas.bind("<Configure>", lambda _event, item=canvas: self._draw_tab_motion_header(item, 1.0))
        self._tab_motion_headers[tab_widget] = canvas
        self._draw_tab_motion_header(canvas, 1.0)
        return canvas

    def _draw_tab_motion_header(self, canvas, progress):
        try:
            if not canvas.winfo_exists():
                return
            width = max(int(canvas.winfo_width()), 1)
        except Exception:
            return

        progress = max(0.0, min(1.0, float(progress)))
        bg = self.current_bg
        fg = self.current_fg
        accent = self.current_btn
        surface = self.current_field
        title = tr(getattr(canvas, "_ljm_title_key", "tab_registration"))
        line_color = blend_color(bg, accent, 0.4 + 0.45 * progress)
        pulse_color = blend_color(bg, accent, 0.18 + 0.22 * progress)
        text_color = blend_color(bg, fg, 0.5 + 0.5 * progress)
        muted_color = blend_color(bg, surface, 0.42)
        bar_width = max(36, int(width * (0.18 + 0.78 * progress)))
        pulse_x = int((width + 80) * progress) - 80

        try:
            canvas.configure(bg=bg)
            canvas.delete("all")
            canvas.create_line(0, 34, width, 34, fill=muted_color, width=1)
            canvas.create_oval(pulse_x, 8, pulse_x + 58, 30, fill=pulse_color, outline="")
            canvas.create_text(12, 18, anchor="w", text=title, fill=text_color, font=("", 11, "bold"))
            if width > 280:
                canvas.create_text(width - 14, 18, anchor="e", text=f"v{VERSION}", fill=blend_color(bg, fg, 0.55), font=("", 9))
            canvas.create_rectangle(0, 35, bar_width, 39, fill=line_color, outline="")
        except Exception:
            pass

    def _animate_tab_motion_header(self, canvas, step=0):
        try:
            if not canvas or not canvas.winfo_exists():
                return
        except Exception:
            return
        if step == 0 and canvas in self._tab_motion_jobs:
            try:
                canvas.after_cancel(self._tab_motion_jobs.pop(canvas))
            except Exception:
                pass

        progress = step / max(1, TAB_MOTION_STEPS)
        self._draw_tab_motion_header(canvas, progress)
        if step >= TAB_MOTION_STEPS:
            self._tab_motion_jobs.pop(canvas, None)
            return
        self._tab_motion_jobs[canvas] = canvas.after(
            TAB_MOTION_INTERVAL_MS,
            lambda: self._animate_tab_motion_header(canvas, step + 1),
        )

    def _animate_selected_tab_motion_header(self):
        try:
            selected_tab = self.notebook.select()
        except Exception:
            return
        for tab_widget, canvas in self._tab_motion_headers.items():
            if str(tab_widget) == selected_tab:
                self._animate_tab_motion_header(canvas)
                return

    def _cancel_notebook_fade(self, reset_state=True):
        self._notebook_fade_generation = getattr(self, "_notebook_fade_generation", 0) + 1
        if self._notebook_fade_job:
            try:
                self.root.after_cancel(self._notebook_fade_job)
            except Exception:
                pass
            self._notebook_fade_job = None
        overlay = self._notebook_fade_overlay
        self._notebook_fade_overlay = None
        if overlay:
            try:
                overlay.destroy()
            except Exception:
                pass
        if reset_state:
            self._notebook_switching = False
            self._pending_notebook_tab = None

    def _selected_tab_motion_canvas(self):
        try:
            selected_tab = self.notebook.select()
        except Exception:
            return None
        for tab_widget, canvas in getattr(self, "_tab_motion_headers", {}).items():
            if str(tab_widget) == selected_tab:
                return canvas
        return None

    def _fade_switch_to_tab(self, target_tab, phase="in", step=0, generation=None):
        if generation is None:
            generation = getattr(self, "_notebook_fade_generation", 0)
        if generation != getattr(self, "_notebook_fade_generation", 0):
            return
        try:
            if str(target_tab) != self.notebook.select():
                self._cancel_notebook_fade()
                return
        except Exception:
            self._cancel_notebook_fade()
            return

        canvas = self._selected_tab_motion_canvas()
        if canvas is None:
            self._cancel_notebook_fade()
            return

        progress = step / max(1, PAGE_FADE_STEPS)
        if phase == "out":
            progress = 1.0 - progress
        self._draw_tab_motion_header(canvas, progress)
        if step < PAGE_FADE_STEPS:
            try:
                self._notebook_fade_job = self.root.after(
                    PAGE_FADE_INTERVAL_MS,
                    lambda gen=generation: self._fade_switch_to_tab(target_tab, phase, step + 1, gen),
                )
            except Exception:
                self._cancel_notebook_fade()
            return
        self._notebook_fade_job = None
        self._notebook_switching = False
        self._pending_notebook_tab = None

    def _switch_notebook_tab(self, tab):
        try:
            target_tab = str(tab)
            current_tab = self.notebook.select()
        except Exception:
            return False
        if not target_tab or target_tab == current_tab:
            self._animate_selected_tab_motion_header()
            return True
        if not getattr(self, "_ui_ready_for_tab_fade", False):
            self.notebook.select(target_tab)
            return True
        self._cancel_notebook_fade()
        self._notebook_switching = True
        self._pending_notebook_tab = None
        self._notebook_fade_generation = getattr(self, "_notebook_fade_generation", 0) + 1
        generation = self._notebook_fade_generation
        try:
            self.notebook.select(target_tab)
        except Exception:
            self._cancel_notebook_fade()
            return False
        self._fade_switch_to_tab(target_tab, "in", 0, generation)
        return True

    def _on_notebook_button_press(self, event):
        try:
            index = self.notebook.index(f"@{event.x},{event.y}")
            target_tab = self.notebook.tabs()[index]
        except Exception:
            return None
        if self._switch_notebook_tab(target_tab):
            return "break"
        return None

    def _repair_mode_label(self, mode=None):
        mode = mode or APP_CONFIG.get("repair_mode", "smart")
        return tr("repair_label_smart") if mode == "smart" else tr("repair_label_full")

    def _repair_mode_summary(self, mode=None):
        mode = mode or APP_CONFIG.get("repair_mode", "smart")
        if mode == "smart":
            return tr("repair_mode_summary_smart")
        return tr("repair_mode_summary_full")

    def refresh_repair_mode_ui(self):
