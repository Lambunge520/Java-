def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                config = json.load(f)
        except Exception:
            config = {}
    else:
        config = {}

    merged = DEFAULT_CONFIG.copy()
    merged.update(config)

    if "direct_mode" not in config and "use_proxy" in config:
        merged["direct_mode"] = not bool(config.get("use_proxy", True))
        merged["direct_mode_auto"] = False

    if merged.get("theme") not in ("纯黑", "纯白", "粉色", "暗粉色"):
        merged["theme"] = DEFAULT_CONFIG["theme"]
    if merged.get("language") not in ("auto", "zh_CN", "en_US"):
        merged["language"] = DEFAULT_CONFIG["language"]
    if merged.get("update_source") not in ("official", "github", "mirror"):
        merged["update_source"] = DEFAULT_CONFIG["update_source"]
    if merged.get("repair_mode") not in ("smart", "full"):
        merged["repair_mode"] = DEFAULT_CONFIG["repair_mode"]
    if merged.get("background_update_check") not in ("off", "daily", "weekly"):
        merged["background_update_check"] = DEFAULT_CONFIG["background_update_check"]
    merged["direct_mode"] = bool(merged.get("direct_mode", False))
    merged["direct_mode_auto"] = bool(merged.get("direct_mode_auto", True))
    merged["enable_mirror"] = bool(merged.get("enable_mirror", False))
    merged["backup_before_changes"] = bool(merged.get("backup_before_changes", True))
    merged["download_cache_enabled"] = bool(merged.get("download_cache_enabled", True))
    merged["verify_download_sha256"] = bool(merged.get("verify_download_sha256", True))
    merged["start_with_system"] = bool(merged.get("start_with_system", False))
    merged["start_minimized_to_tray"] = bool(merged.get("start_minimized_to_tray", False))
    try:
        merged["last_background_update_check"] = float(merged.get("last_background_update_check", 0) or 0)
    except Exception:
        merged["last_background_update_check"] = 0
    try:
        merged["last_mirror_speedtest"] = float(merged.get("last_mirror_speedtest", 0) or 0)
    except Exception:
        merged["last_mirror_speedtest"] = 0
    if not isinstance(merged.get("fast_mirror_order"), list):
        merged["fast_mirror_order"] = []
    if not isinstance(merged.get("mirror_speed_results"), dict):
        merged["mirror_speed_results"] = {}
    return merged


def save_config(config):
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=4, ensure_ascii=False)
    except Exception as exc:
        logging.error("保存配置失败: %s", exc)


def app_launch_command():
    if getattr(sys, "frozen", False):
        return f'"{APP_EXECUTABLE_PATH}"'
    python_executable = sys.executable
    if IS_WIN:
        pythonw = os.path.join(os.path.dirname(sys.executable), "pythonw.exe")
        if os.path.exists(pythonw):
            python_executable = pythonw
    return f'"{python_executable}" "{APP_EXECUTABLE_PATH}"'


def sync_autostart_setting(enabled):
    try:
        if IS_WIN:
            key = winreg.OpenKey(
                winreg.HKEY_CURRENT_USER,
                r"Software\Microsoft\Windows\CurrentVersion\Run",
                0,
                winreg.KEY_SET_VALUE,
            )
            try:
                if enabled:
                    winreg.SetValueEx(key, "LJMJavaManager", 0, winreg.REG_SZ, app_launch_command())
                else:
                    try:
                        winreg.DeleteValue(key, "LJMJavaManager")
                    except FileNotFoundError:
                        pass
            finally:
                winreg.CloseKey(key)
            return True

        if sys.platform == "darwin":
            launch_dir = os.path.expanduser("~/Library/LaunchAgents")
            os.makedirs(launch_dir, exist_ok=True)
            plist_path = os.path.join(launch_dir, "com.ljm.javamanager.plist")
            if enabled:
                program_args = [sys.executable, APP_EXECUTABLE_PATH] if not getattr(sys, "frozen", False) else [APP_EXECUTABLE_PATH]
                args_xml = "\n".join(f"        <string>{arg}</string>" for arg in program_args)
                content = (
                    '<?xml version="1.0" encoding="UTF-8"?>\n'
                    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                    '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
                    '<plist version="1.0">\n'
                    '<dict>\n'
                    '    <key>Label</key><string>com.ljm.javamanager</string>\n'
                    '    <key>ProgramArguments</key>\n'
                    '    <array>\n'
                    f"{args_xml}\n"
                    '    </array>\n'
                    '    <key>RunAtLoad</key><true/>\n'
                    '</dict>\n'
                    '</plist>\n'
                )
                with open(plist_path, "w", encoding="utf-8") as f:
                    f.write(content)
            elif os.path.exists(plist_path):
                os.remove(plist_path)
            return True

        autostart_dir = os.path.expanduser("~/.config/autostart")
        os.makedirs(autostart_dir, exist_ok=True)
        desktop_path = os.path.join(autostart_dir, "ljm-java-manager.desktop")
        if enabled:
            with open(desktop_path, "w", encoding="utf-8") as f:
                f.write(
                    "[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=Java Core Environment Manager\n"
                    f"Exec={app_launch_command()}\n"
                    "Terminal=false\n"
                    "X-GNOME-Autostart-enabled=true\n"
                )
        elif os.path.exists(desktop_path):
            os.remove(desktop_path)
        return True
    except Exception as exc:
        logging.error("同步开机自启失败: %s", exc)
        return False


